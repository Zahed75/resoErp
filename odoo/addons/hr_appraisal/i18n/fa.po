#. module: hr_appraisal
#: model:mail.template,body_html:hr_appraisal.mail_template_appraisal_confirm
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;"
"\">\n"
"                        An appraisal of <t t-"
"out=\"ctx.get('employee_to_name')\">employee</t> has been confirmed.\n"
"                        <br/><br/>\n"
"                        Please schedule an appraisal date together.\n"
"                        <br/><br/>\n"
"                        <t t-if=\"ctx.get('recipient_users')\">\n"
"                            <p style=\"margin: 16px 0px 16px 0px; text-"
"align: center;\">\n"
"                                <a t-att-href=\"ctx.get('url')\" t-attf-"
"style=\"background-color: {{object.company_id.email_secondary_color or "
"'#875A7B'}}; padding: 8px 16px 8px 16px; text-decoration: none; color: "
"{{object.company_id.email_primary_color or '#FFFFFF'}}; border-radius: 5px;"
"\">\n"
"                                    View Appraisal\n"
"                                </a>\n"
"                            </p>\n"
"                        </t>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div dir=\"rtl\" style=\"margin: 0px; padding: 0px; font-family: IRANSans, "
"IRANSansX, Arial, sans-serif;\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        ارزیابی <t t-out=\"ctx.get('employee_to_name')\">کارمند</t> تأیید "
"شد.\n"
"        <br/><br/>\n"
"        لطفاً با هماهنگی یکدیگر زمانی را برای جلسه ارزیابی تعیین کنید.\n"
"        <br/><br/>\n"
"        <t t-if=\"ctx.get('recipient_users')\">\n"
"            <p style=\"margin: 16px 0px 16px 0px; text-align: center;\">\n"
"                <a t-att-href=\"ctx.get('url')\" t-attf-style=\"background-"
"color: {{object.company_id.email_secondary_color or '#875A7B'}}; padding: "
"8px 16px 8px 16px; text-decoration: none; color: "
"{{object.company_id.email_primary_color or '#FFFFFF'}}; border-radius: 5px;"
"\">\n"
"                    مشاهده ارزیابی\n"
"                </a>\n"
"            </p>\n"
"        </t>\n"
"    </p>\n"
"</div>\n"
"            "

#. module: hr_appraisal
#: model:mail.template,body_html:hr_appraisal.mail_template_appraisal_request_from_employee
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;"
"\">\n"
"                        Dear <t t-out=\"ctx.get('employee_to_name')"
"\">employee</t>,\n"
"                        <br/>\n"
"                        <t t-out=\"ctx.get('author_name', '')\">Addison "
"Olson</t> (<t t-out=\"ctx.get('author_mail', '')"
"\">addison.olson28@example.com</t>) wishes an appraisal.\n"
"                        <t t-if=\"ctx.get('user_body')\">\n"
"                            <div style=\"margin: 16px 0px 16px 0px; padding: "
"8px 16px 8px 16px; background-color: #F1F1F1;\">\n"
"                                <t t-out=\"ctx.get('user_body')\">Annual "
"appraisal.</t>\n"
"                            </div>\n"
"                        </t>\n"
"                        <t t-if=\"ctx.get('recipient_users')\">\n"
"                            <p style=\"margin: 16px 0px 16px 0px; padding: "
"8px 16px 8px 16px; text-align: center;\">\n"
"                                <a t-att-href=\"ctx.get('url')\" t-attf-"
"style=\" margin: auto; background-color: "
"{{object.employee_id.company_id.email_secondary_color or '#875A7B'}}; "
"padding: 8px 16px 8px 16px; text-decoration: none; color: "
"{{object.employee_id.company_id.email_primary_color or '#FFFFFF'}}; border-"
"radius: 5px;\">\n"
"                                    View Appraisal\n"
"                                </a>\n"
"                            </p>\n"
"                        </t>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div dir=\"rtl\" style=\"margin: 0px; padding: 0px; font-family: IRANSans, "
"IRANSansX, Arial, sans-serif;\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        <t t-out=\"ctx.get('employee_to_name')\">کارمند</t> گرامی،\n"
"        <br/>\n"
"        <t t-out=\"ctx.get('author_name', '')\">محمد علی</t> (<t t-"
"out=\"ctx.get('author_mail', '')\">addison.olson28@example.com</t>) درخواست "
"ارزیابی دارد.\n"
"        <t t-if=\"ctx.get('user_body')\">\n"
"            <div style=\"margin: 16px 0px 16px 0px; padding: 8px 16px 8px "
"16px; background-color: #F1F1F1;\">\n"
"                <t t-out=\"ctx.get('user_body')\">ارزیابی سالانه.</t>\n"
"            </div>\n"
"        </t>\n"
"        <t t-if=\"ctx.get('recipient_users')\">\n"
"            <p style=\"margin: 16px 0px 16px 0px; padding: 8px 16px 8px "
"16px; text-align: center;\">\n"
"                <a t-att-href=\"ctx.get('url')\" t-attf-style=\" margin: "
"auto; background-color: "
"{{object.employee_id.company_id.email_secondary_color or '#875A7B'}}; "
"padding: 8px 16px 8px 16px; text-decoration: none; color: "
"{{object.employee_id.company_id.email_primary_color or '#FFFFFF'}}; border-"
"radius: 5px;\">\n"
"                    مشاهده ارزیابی\n"
"                </a>\n"
"            </p>\n"
"        </t>\n"
"    </p>\n"
"</div>\n"
"            "

#. module: hr_appraisal
#: model:mail.template,body_html:hr_appraisal.mail_template_appraisal_reminder
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;"
"\">\n"
"                        Hi <t t-out=\"ctx.get('employee_to_name')"
"\">[employee]</t>,\n"
"                        <br/>\n"
"                        Just a quick reminder that your next appraisal with "
"<t t-out=\"ctx.get('manager_names')\"> [Appraisers]</t>\n"
"                        is scheduled for <t t-out=\"ctx.get('date_close')"
"\">[deadline]</t>.\n"
"                        <br/>\n"
"                        <t t-if=\"ctx.get('user_body')\">\n"
"                            <div class=\"my-3 py-2 px-3 bg-secondary\">\n"
"                                <t t-out=\"ctx.get('user_body')\">[Optional "
"comment]</t>\n"
"                            </div>\n"
"                        </t>\n"
"                        <t t-if=\"ctx.get('recipient_users')\">\n"
"                            You can access your appraisal form here:\n"
"                            <p class=\"text-center my-3 py-2 px-3\">\n"
"                                <a t-att-href=\"ctx.get('url')\" t-attf-"
"style=\" margin: auto; background-color: "
"{{object.company_id.email_secondary_color or '#875A7B'}}; padding: 8px 16px "
"8px 16px; text-decoration: none; color: "
"{{object.company_id.email_primary_color or '#FFFFFF'}}; border-radius: 5px;"
"\">\n"
"                                    View Appraisal\n"
"                                </a>\n"
"                            </p>\n"
"                        </t>\n"
"                        If you have any questions or need to reschedule, "
"feel free to reach out.\n"
"                        <br/>\n"
"                        <br/>\n"
"                        <t t-out=\"ctx.get('author_signature')\"/>\n"
"                        <br/>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;"
"\">\n"
"                        سلام <t t-out=\"ctx.get('employee_to_name')\">[نام "
"کارمند]</t>،\n"
"                        <br/>\n"
"                        جهت یادآوری، ارزیابی بعدی شما با <t t-"
"out=\"ctx.get('manager_names')\"> [ارزیابان]</t>\n"
"                        برای تاریخ <t t-out=\"ctx.get('date_close')"
"\">[سررسید]</t> برنامه‌ریزی شده است.\n"
"                        <br/>\n"
"                        <t t-if=\"ctx.get('user_body')\">\n"
"                            <div class=\"my-3 py-2 px-3 bg-secondary\">\n"
"                                <t t-out=\"ctx.get('user_body')\">[ملاحظات "
"اختیاری]</t>\n"
"                            </div>\n"
"                        </t>\n"
"                        <t t-if=\"ctx.get('recipient_users')\">\n"
"                            شما می‌توانید از اینجا به فرم ارزیابی خود دسترسی "
"داشته باشید:\n"
"                            <p class=\"text-center my-3 py-2 px-3\">\n"
"                                <a t-att-href=\"ctx.get('url')\" t-attf-"
"style=\" margin: auto; background-color: "
"{{object.company_id.email_secondary_color or '#875A7B'}}; padding: 8px 16px "
"8px 16px; text-decoration: none; color: "
"{{object.company_id.email_primary_color or '#FFFFFF'}}; border-radius: 5px;"
"\">\n"
"                                    مشاهده ارزیابی\n"
"                                </a>\n"
"                            </p>\n"
"                        </t>\n"
"                        اگر سؤالی دارید یا نیاز به تغییر زمان‌بندی دارید، "
"لطفاً تماس بگیرید.\n"
"                        <br/>\n"
"                        <br/>\n"
"                        <t t-out=\"ctx.get('author_signature')\"/>\n"
"                        <br/>\n"
"                    </p>\n"
"                </div>\n"
"            "

#. module: hr_appraisal
#: model_terms:hr.appraisal.template,appraisal_employee_feedback_template:hr_appraisal.hr_appraisal_default_template
msgid ""
"<em>\n"
"                        Describe something you are proud of—work that had a "
"positive impact on\n"
"                        the company.\n"
"                    </em>"
msgstr ""
"<em>\n"
"                        چیزی که به آن افتخار می‌کنید را شرح دهید — کاری که "
"تأثیر مثبتی بر روی\n"
"                        شرکت داشته است.\n"
"                    </em>"

#. module: hr_appraisal
#: model_terms:hr.appraisal.template,appraisal_employee_feedback_template:hr_appraisal.hr_appraisal_default_template
msgid ""
"<em>\n"
"                        Did you face any new difficulties or unexpected "
"obstacles?\n"
"                    </em>"
msgstr ""
"<em>\n"
"                        آیا با مشکلات جدید یا موانع غیرمنتظره‌ای مواجه شدید؟\n"
"                    </em>"

#. module: hr_appraisal
#: model_terms:hr.appraisal.template,appraisal_employee_feedback_template:hr_appraisal.hr_appraisal_default_template
msgid ""
"<em>\n"
"                        Every job has its strong points. In your opinion, "
"which tasks do you \n"
"                        enjoy the most and which the least?\n"
"                    </em>"
msgstr ""
"<em>\n"
"                        هر شغلی نقاط قوت خود را دارد. به نظر شما، از انجام "
"کدام وظایف \n"
"                        بیشتر و از کدام کمتر لذت می‌برید؟\n"
"                    </em>"

#. module: hr_appraisal
#: model_terms:hr.appraisal.template,appraisal_manager_feedback_template:hr_appraisal.hr_appraisal_default_template
msgid ""
"<em>\n"
"                        From a manager’s point of view, how could you help "
"them overcome their weaknesses?\n"
"                    </em>"
msgstr ""
"<em>\n"
"                        از دیدگاه یک مدیر، چگونه می‌توانید به او کمک کنید تا "
"بر نقاط ضعف خود غلبه کند؟\n"
"                    </em>"

#. module: hr_appraisal
#: model_terms:hr.appraisal.template,appraisal_employee_feedback_template:hr_appraisal.hr_appraisal_default_template
msgid ""
"<em>\n"
"                        How can the company support your needs and "
"objectives to help you \n"
"                        reach your goals and foster better collaboration?\n"
"                    </em>"
msgstr ""
"<em>\n"
"                        شرکت چگونه می‌تواند از نیازها و اهداف شما پشتیبانی "
"کند تا به شما در \n"
"                        رسیدن به اهدافتان و تقویت همکاری بهتر کمک نماید؟\n"
"                    </em>"

#. module: hr_appraisal
#: model_terms:hr.appraisal.template,appraisal_manager_feedback_template:hr_appraisal.hr_appraisal_default_template
msgid ""
"<em>\n"
"                        How do you see the employee in the future? Does your "
"vision align with \n"
"                        the employee’s goals?\n"
"                    </em>"
msgstr ""
"<em>\n"
"                        آینده این کارمند را چگونه می‌بینید؟ آیا دیدگاه شما "
"با \n"
"                        اهداف او همسو است؟\n"
"                    </em>"

#. module: hr_appraisal
#: model_terms:hr.appraisal.template,appraisal_manager_feedback_template:hr_appraisal.hr_appraisal_default_template
msgid ""
"<em>\n"
"                        Mention any achievements that demonstrate their "
"strengths in \n"
"                        handling work-related challenges.\n"
"                    </em>"
msgstr ""
"<em>\n"
"                        به دستاوردهایی اشاره کنید که نقاط قوت او را در \n"
"                        مدیریت چالش‌های کاری نشان می‌دهد.\n"
"                    </em>"

#. module: hr_appraisal
#: model_terms:hr.appraisal.template,appraisal_manager_feedback_template:hr_appraisal.hr_appraisal_default_template
msgid "<em>Autonomy</em>"
msgstr "<em>استقلال کاری</em>"

