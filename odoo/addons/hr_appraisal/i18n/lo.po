#. module: hr_appraisal
#. odoo-python
#: code:addons/hr_appraisal/models/hr_appraisal.py:0
msgid "%(user)s decided, as %(role)s, to publish the employee's feedback"
msgstr "%(user)s ຕັດສິນໃຈ, ໃນຖານະເປັນ %(role)s, ເພື່ອເຜີຍແຜ່ຄຳຄິດເຫັນຂອງພະນັກງານ"

#. module: hr_appraisal
#. odoo-python
#: code:addons/hr_appraisal/models/hr_appraisal_goal.py:0
#: code:addons/hr_appraisal/models/hr_appraisal_template.py:0
msgid "%s (copy)"
msgstr "%s (ສຳເນົາ)"

#. module: hr_appraisal
#. odoo-python
#: code:addons/hr_appraisal/models/hr_appraisal.py:0
msgid "%s's Goals"
msgstr "ເປົ້າໝາຍຂອງ %s"

#. module: hr_appraisal
#: model:ir.model.fields,help:hr_appraisal.field_hr_appraisal_campaign_wizard__manager
msgid ""
"'Employee's Manager': Each appraisal will be conducted by the direct manager "
"of the employee\n"
"'Specific Person': All appraisals will be conducted by the specified "
"employees"
msgstr ""
"'ຜູ້ຈັດການຂອງພະນັກງານ': ແຕ່ລະການປະເມີນຜົນຈະຖືກດຳເນີນໂດຍຜູ້ຈັດການສາຍກົງຂອງພະນັກງານ\n"
"'ບຸກຄົນສະເພາະ': ທຸກໆການປະເມີນຜົນຈະຖືກດຳເນີນໂດຍພະນັກງານທີ່ຖືກລະບຸໄວ້"

#. module: hr_appraisal
#: model_terms:ir.ui.view,arch_db:hr_appraisal.view_hr_appraisal_form
msgid ". Then, schedule a meeting to discuss it."
msgstr ". ຈາກນັ້ນ, ກຳນົດເວລາການປະຊຸມເພື່ອປຶກສາຫາລື."

#. module: hr_appraisal
#: model_terms:ir.ui.view,arch_db:hr_appraisal.view_hr_appraisal_form
msgid ". Then, share it with appraisers."
msgstr ". ຈາກນັ້ນ, ແບ່ງປັນໃຫ້ກັບຜູ້ປະເມີນ."

#. module: hr_appraisal
#: model:ir.model.fields,field_description:hr_appraisal.field_res_config_settings__module_hr_appraisal_survey
#: model_terms:ir.ui.view,arch_db:hr_appraisal.res_config_settings_view_employee_form
msgid "360 Feedback"
msgstr "ຄຳຄິດເຫັນແບບ 360 ອົງສາ"

#. module: hr_appraisal
#: model:mail.template,body_html:hr_appraisal.mail_template_appraisal_confirm
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;"
"\">\n"
"                        An appraisal of <t t-"
"out=\"ctx.get('employee_to_name')\">employee</t> has been confirmed.\n"
"                        <br/><br/>\n"
"                        Please schedule an appraisal date together.\n"
"                        <br/><br/>\n"
"                        <t t-if=\"ctx.get('recipient_users')\">\n"
"                            <p style=\"margin: 16px 0px 16px 0px; text-"
"align: center;\">\n"
"                                <a t-att-href=\"ctx.get('url')\" t-attf-"
"style=\"background-color: {{object.company_id.email_secondary_color or "
"'#875A7B'}}; padding: 8px 16px 8px 16px; text-decoration: none; color: "
"{{object.company_id.email_primary_color or '#FFFFFF'}}; border-radius: 5px;"
"\">\n"
"                                    View Appraisal\n"
"                                </a>\n"
"                            </p>\n"
"                        </t>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">"
"\n"
"                        ການປະເມີນຜົນຂອງ <t t-out=\"ctx.get('employee_to_name')"
"\">ພະນັກງານ</t> ໄດ້ຖືກຢືນຢັນແລ້ວ.\n"
"                        <br/><br/>\n"
"                        ກະລຸນານັດໝາຍວັນທີປະເມີນຜົນຮ່ວມກັນ.\n"
"                        <br/><br/>\n"
"                        <t t-if=\"ctx.get('recipient_users')\">\n"
"                            <p style=\"margin: 16px 0px 16px 0px; text-"
"align: center;\">\n"
"                                <a t-att-href=\"ctx.get('url')\" t-attf-"
"style=\"background-color: {{object.company_id.email_secondary_color or "
"'#875A7B'}}; padding: 8px 16px 8px 16px; text-decoration: none; color: {"
"{object.company_id.email_primary_color or '#FFFFFF'}}; border-radius: 5px;\">"
"\n"
"                                    ເບິ່ງການປະເມີນຜົນ\n"
"                                </a>\n"
"                            </p>\n"
"                        </t>\n"
"                    </p>\n"
"                </div>\n"
"            "

#. module: hr_appraisal
#: model:mail.template,body_html:hr_appraisal.mail_template_appraisal_request_from_employee
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;"
"\">\n"
"                        Dear <t t-out=\"ctx.get('employee_to_name')"
"\">employee</t>,\n"
"                        <br/>\n"
"                        <t t-out=\"ctx.get('author_name', '')\">Addison "
"Olson</t> (<t t-out=\"ctx.get('author_mail', '')"
"\">addison.olson28@example.com</t>) wishes an appraisal.\n"
"                        <t t-if=\"ctx.get('user_body')\">\n"
"                            <div style=\"margin: 16px 0px 16px 0px; padding: "
"8px 16px 8px 16px; background-color: #F1F1F1;\">\n"
"                                <t t-out=\"ctx.get('user_body')\">Annual "
"appraisal.</t>\n"
"                            </div>\n"
"                        </t>\n"
"                        <t t-if=\"ctx.get('recipient_users')\">\n"
"                            <p style=\"margin: 16px 0px 16px 0px; padding: "
"8px 16px 8px 16px; text-align: center;\">\n"
"                                <a t-att-href=\"ctx.get('url')\" t-attf-"
"style=\" margin: auto; background-color: "
"{{object.employee_id.company_id.email_secondary_color or '#875A7B'}}; "
"padding: 8px 16px 8px 16px; text-decoration: none; color: "
"{{object.employee_id.company_id.email_primary_color or '#FFFFFF'}}; border-"
"radius: 5px;\">\n"
"                                    View Appraisal\n"
"                                </a>\n"
"                            </p>\n"
"                        </t>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">"
"\n"
"                        ຮຽນ <t t-out=\"ctx.get('employee_to_name')\">ພະນັກງາ"
"ນ</t>,\n"
"                        <br/>\n"
"                        <t t-out=\"ctx.get('author_name', '')\">Addison "
"Olson</t> (<t t-out=\"ctx.get('author_mail', '')\">"
"addison.olson28@example.com</t>) ມີຄວາມປະສົງຈະຂໍຮັບການປະເມີນຜົນ.\n"
"                        <t t-if=\"ctx.get('user_body')\">\n"
"                            <div style=\"margin: 16px 0px 16px 0px; padding: "
"8px 16px 8px 16px; background-color: #F1F1F1;\">\n"
"                                <t t-out=\"ctx.get('user_body')\">ການປະເມີນຜົນປ"
"ະຈຳປີ.</t>\n"
"                            </div>\n"
"                        </t>\n"
"                        <t t-if=\"ctx.get('recipient_users')\">\n"
"                            <p style=\"margin: 16px 0px 16px 0px; padding: "
"8px 16px 8px 16px; text-align: center;\">\n"
"                                <a t-att-href=\"ctx.get('url')\" t-attf-"
"style=\" margin: auto; background-color: {"
"{object.employee_id.company_id.email_secondary_color or '#875A7B'}}; "
"padding: 8px 16px 8px 16px; text-decoration: none; color: {"
"{object.employee_id.company_id.email_primary_color or '#FFFFFF'}}; border-"
"radius: 5px;\">\n"
"                                    ເບິ່ງການປະເມີນຜົນ\n"
"                                </a>\n"
"                            </p>\n"
"                        </t>\n"
"                    </p>\n"
"                </div>\n"
"            "

#. module: hr_appraisal
#: model:mail.template,body_html:hr_appraisal.mail_template_appraisal_reminder
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;"
"\">\n"
"                        Hi <t t-out=\"ctx.get('employee_to_name')"
"\">[employee]</t>,\n"
"                        <br/>\n"
"                        Just a quick reminder that your next appraisal with "
"<t t-out=\"ctx.get('manager_names')\"> [Appraisers]</t>\n"
"                        is scheduled for <t t-out=\"ctx.get('date_close')"
"\">[deadline]</t>.\n"
"                        <br/>\n"
"                        <t t-if=\"ctx.get('user_body')\">\n"
"                            <div class=\"my-3 py-2 px-3 bg-secondary\">\n"
"                                <t t-out=\"ctx.get('user_body')\">[Optional "
"comment]</t>\n"
"                            </div>\n"
"                        </t>\n"
"                        <t t-if=\"ctx.get('recipient_users')\">\n"
"                            You can access your appraisal form here:\n"
"                            <p class=\"text-center my-3 py-2 px-3\">\n"
"                                <a t-att-href=\"ctx.get('url')\" t-attf-"
"style=\" margin: auto; background-color: "
"{{object.company_id.email_secondary_color or '#875A7B'}}; padding: 8px 16px "
"8px 16px; text-decoration: none; color: "
"{{object.company_id.email_primary_color or '#FFFFFF'}}; border-radius: 5px;"
"\">\n"
"                                    View Appraisal\n"
"                                </a>\n"
"                            </p>\n"
"                        </t>\n"
"                        If you have any questions or need to reschedule, "
"feel free to reach out.\n"
"                        <br/>\n"
"                        <br/>\n"
"                        <t t-out=\"ctx.get('author_signature')\"/>\n"
"                        <br/>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">"
"\n"
"                        ສະບາຍດີ <t t-out=\"ctx.get('employee_to_name')\">[ພະນັກ"
"ງານ]</t>,\n"
"                        <br/>\n"
"                        ຂໍເຕືອນສັ້ນໆວ່າການປະເມີນຜົນຄັ້ງຕໍ່ໄປຂອງທ່ານກັບ <t t-out=\"ctx.get"
"('manager_names')\"> [ຜູ້ປະເມີນ]</t>\n"
"                        ໄດ້ຖືກກຳນົດໄວ້ໃນວັນທີ <t t-out=\"ctx.get('date_close')\">[ກ"
"ຳນົດເວລາ]</t>.\n"
"                        <br/>\n"
"                        <t t-if=\"ctx.get('user_body')\">\n"
"                            <div class=\"my-3 py-2 px-3 bg-secondary\">\n"
"                                <t t-out=\"ctx.get('user_body')\">[ຄຳຄິດເຫັນເພີ່ມ"
"ເຕີມ]</t>\n"
"                            </div>\n"
"                        </t>\n"
"                        <t t-if=\"ctx.get('recipient_users')\">\n"
"                            ທ່ານສາມາດເຂົ້າເຖິງແບບຟອມການປະເມີນຜົນຂອງທ່ານໄດ້ທີ່ນີ້:\n"
"                            <p class=\"text-center my-3 py-2 px-3\">\n"
"                                <a t-att-href=\"ctx.get('url')\" t-attf-"
"style=\" margin: auto; background-color: {"
"{object.company_id.email_secondary_color or '#875A7B'}}; padding: 8px 16px "
"8px 16px; text-decoration: none; color: {"
"{object.company_id.email_primary_color or '#FFFFFF'}}; border-radius: 5px;\">"
"\n"
"                                    ເບິ່ງການປະເມີນຜົນ\n"
"                                </a>\n"
"                            </p>\n"
"                        </t>\n"
"                        ຫາກທ່ານມີຄຳຖາມ ຫຼື ຕ້ອງການປ່ຽນຕາຕະລາງໃໝ່, ສາມາດຕິດຕໍ່ສອບຖາມໄ"
"ດ້.\n"
"                        <br/>\n"
"                        <br/>\n"
"                        <t t-out=\"ctx.get('author_signature')\"/>\n"
"                        <br/>\n"
"                    </p>\n"
"                </div>\n"
"            "

#. module: hr_appraisal
#: model_terms:hr.appraisal.template,appraisal_employee_feedback_template:hr_appraisal.hr_appraisal_default_template
msgid ""
"<em>\n"
"                        Describe something you are proud of—work that had a "
"positive impact on\n"
"                        the company.\n"
"                    </em>"
msgstr ""
"<em>\n"
"                        ອະທິບາຍບາງສິ່ງທີ່ເຈົ້າພູມໃຈ—ວຽກທີ່ມີຜົນກະທົບທາງບວກຕໍ່ບໍລິສັດ.\n"
"                    </em>"

#. module: hr_appraisal
#: model_terms:hr.appraisal.template,appraisal_employee_feedback_template:hr_appraisal.hr_appraisal_default_template
msgid ""
"<em>\n"
"                        Did you face any new difficulties or unexpected "
"obstacles?\n"
"                    </em>"
msgstr ""
"<em>\n"
"                        ເຈົ້າໄດ້ພົບກັບຄວາມຫຍຸ້ງຍາກໃໝ່ໆ ຫຼື ອຸປະສັກທີ່ບໍ່ຄາດຄິດບໍ່?\n"
"                    </em>"

#. module: hr_appraisal
#: model_terms:hr.appraisal.template,appraisal_employee_feedback_template:hr_appraisal.hr_appraisal_default_template
msgid ""
"<em>\n"
"                        Every job has its strong points. In your opinion, "
"which tasks do you \n"
"                        enjoy the most and which the least?\n"
"                    </em>"
msgstr ""
"<em>\n"
"                        ທຸກໆວຽກລ້ວນແຕ່ມີຈຸດເດັ່ນ. ໃນຄວາມຄິດເຫັນຂອງເຈົ້າ, ວຽກໃດທີ່ເຈົ້າມັກຫຼາຍທີ່"
"ສຸດ ແລະ ວຽກໃດທີ່ມັກໜ້ອຍທີ່ສຸດ?\n"
"                    </em>"

#. module: hr_appraisal
#: model_terms:hr.appraisal.template,appraisal_manager_feedback_template:hr_appraisal.hr_appraisal_default_template
msgid ""
"<em>\n"
"                        From a manager’s point of view, how could you help "
"them overcome their weaknesses?\n"
"                    </em>"
msgstr ""
"<em>\n"
"                        ຈາກມຸມມອງຂອງຜູ້ຈັດການ, ເຈົ້າຈະສາມາດຊ່ວຍພວກເຂົາແກ້ໄຂຈຸດອ່ອນໄດ້ແນວໃ"
"ດ?\n"
"                    </em>"

#. module: hr_appraisal
#: model_terms:hr.appraisal.template,appraisal_employee_feedback_template:hr_appraisal.hr_appraisal_default_template
msgid ""
"<em>\n"
"                        How can the company support your needs and "
"objectives to help you \n"
"                        reach your goals and foster better collaboration?\n"
"                    </em>"
msgstr ""
"<em>\n"
"                        ບໍລິສັດສາມາດສະໜັບສະໜູນຄວາມຕ້ອງການ ແລະ ຈຸດປະສົງຂອງເຈົ້າແນວໃດ ເພື່ອ"
"ຊ່ວຍໃຫ້ເຈົ້າບັນລຸເປົ້າໝາຍ ແລະ ສົ່ງເສີມການຮ່ວມມືທີ່ດີຂຶ້ນ?\n"
"                    </em>"

#. module: hr_appraisal
#: model_terms:hr.appraisal.template,appraisal_manager_feedback_template:hr_appraisal.hr_appraisal_default_template
msgid ""
"<em>\n"
"                        How do you see the employee in the future? Does your "
"vision align with \n"
"                        the employee’s goals?\n"
"                    </em>"
msgstr ""
"<em>\n"
"                        ເຈົ້າມອງເຫັນພະນັກງານໃນອະນາຄົດແນວໃດ? ວິໄສທັດຂອງເຈົ້າສອດຄ່ອງກັບເປົ້າ"
"ໝາຍຂອງພະນັກງານບໍ່?\n"
"                    </em>"

#. module: hr_appraisal
#: model_terms:hr.appraisal.template,appraisal_manager_feedback_template:hr_appraisal.hr_appraisal_default_template
msgid ""
"<em>\n"
"                        Mention any achievements that demonstrate their "
"strengths in \n"
"                        handling work-related challenges.\n"
"                    </em>"
msgstr ""
"<em>\n"
"                        ລະບຸຜົນສຳເລັດໃດໜຶ່ງທີ່ສະແດງໃຫ້ເຫັນເຖິງຈຸດເດັ່ນຂອງພວກເຂົາໃນການຈັດການກັ"
"ບສິ່ງທ້າທາຍທີ່ກ່ຽວຂ້ອງກັບວຽກ.\n"
"                    </em>"

#. module: hr_appraisal
#: model_terms:hr.appraisal.template,appraisal_manager_feedback_template:hr_appraisal.hr_appraisal_default_template
msgid "<em>Autonomy</em>"
msgstr "<em>ຄວາມເປັນອິດສະຫຼະໃນການເຮັດວຽກ</em>"

#. module: hr_appraisal
#: model_terms:hr.appraisal.template,appraisal_employee_feedback_template:hr_appraisal.hr_appraisal_default_template
msgid "<em>Company culture and values</em>"
msgstr "<em>ວັດທະນະທຳ ແລະ ຄ່ານິຍົມຂອງບໍລິສັດ</em>"

#. module: hr_appraisal
#: model_terms:hr.appraisal.template,appraisal_employee_feedback_template:hr_appraisal.hr_appraisal_default_template
msgid "<em>Compensation</em>"
msgstr "<em>ຄ່າຕອບແທນ</em>"

#. module: hr_appraisal
#: model_terms:hr.appraisal.template,appraisal_manager_feedback_template:hr_appraisal.hr_appraisal_default_template
msgid "<em>Do you need a rapid response to address the current situation?</em>"
msgstr ""
