#. module: sale_shopee
#: model:mail.template,body_html:sale_shopee.order_sync_failure
#, fuzzy
msgid ""
"<div>\n"
"                <p>The synchronization of the Shopee order with reference <t "
"t-out=\"ctx.get('shopee_order_ref') or ''\">REF</t> encountered an error and "
"was not completed.</p>\n"
"                <p>Unless the order is cancelled in Shopee, no other "
"synchronization will be attempted.</p>\n"
"                <p>To schedule a new synchronization attempt, proceed as "
"follows:\n"
"                    </p><ol>\n"
"                        <li>Enter the Developer Tools.</li>\n"
"                        <li>Open the form of the Shopee Shop on which the "
"order was placed.</li>\n"
"                        <li>Navigate to the Order Follow-up tab.</li>\n"
"                        <li>Set a date for <em>Last Order Synchronization "
"Date</em> that is anterior to the last status update of the order.</li>\n"
"                        <li>Save the changes and click on the <em>SYNC "
"ORDERS</em> button.</li>\n"
"                    </ol>\n"
"                \n"
"                <p>If the problem persists, contact <a href=\"https://"
"www.odoo.com/help/\">Odoo support</a>.</p>\n"
"            </div>\n"
"        "
msgstr ""
"<div>\n"
"                <p>Sinhronizacija naročila Shopee s sklicem <t t-"
"out=\"ctx.get('shopee_order_ref') or ''\">REF</t> je naletela na napako in "
"ni bila dokončana.</p>\n"
"                <p>Če naročilo ni preklicano v Shopeeju, noben drug poskus "
"sinhronizacije ne bo izveden.</p>\n"
"                <p>Če želite načrtovati nov poskus sinhronizacije, storite "
"naslednje:\n"
"                    </p><ol>\n"
"                        <li>Odprite razvojna orodja.</li>\n"
"                        <li>Odprite obrazec trgovine Shopee, v kateri je "
"bilo naročilo oddano.</li>\n"
"                        <li>Odprite zavihek Spremljanje naročil.</li>\n"
"                        <li>Nastavite datum za <em>Datum zadnje "
"sinhronizacije naročil</em>, ki je pred zadnjo posodobitvijo statusa "
"naročila.</li>\n"
"                        <li>Shranite spremembe in kliknite gumb <em>"
"SINHRONIZIRAJ NAROČILA</em>.</li>\n"
"                    </ol>\n"
"                \n"
"                <p>Če težava ni odpravljena, se obrnite na <a href=\"https://"
"www.odoo.com/help/\">podporo Odoo</a>.</p>\n"
"            </div>\n"
"        "

