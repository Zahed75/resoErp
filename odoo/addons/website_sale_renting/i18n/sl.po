msgid ""
"\n"
"                Your rental duration was too short. Unfortunately, we do not "
"process\n"
"                rentals that last less than %(duration)s %(unit)s.\n"
"            "
msgstr ""
"                Vaše trajanje najema je bilo prekratko. Na žalost ne "
"obdelujemo\n"
"                najemov, ki trajajo manj kot %(duration)s %(unit)s.\n"
"            "

#. module: website_sale_renting
#. odoo-python
#: code:addons/website_sale_renting/models/sale_order.py:0
#, fuzzy
msgid ""
"\n"
"                Your rental product had invalid date of pickup (%"
"(start_date)s).\n"
"                Unfortunately, we do not process pickups on that weekday.\n"
"            "
msgstr ""
"                Datum prevzema vašega izdelka za najem (%(start_date)s) ni "
"veljaven.\n"
"                Na žalost prevzemov ob tem dnevu v tednu ne izvajamo.\n"
"            "

#. module: website_sale_renting
#. odoo-python
#: code:addons/website_sale_renting/models/sale_order.py:0
#, fuzzy
msgid ""
"\n"
"                Your rental product had invalid date of return (%"
"(end_date)s).\n"
"                Unfortunately, we do not process returns on that weekday.\n"
"            "
msgstr ""
"                Datum vračila vašega izdelka za najem (%(end_date)s) ni "
"veljaven.\n"
"                Na žalost vračil ob tem dnevu v tednu ne izvajamo.\n"
"            "

#. module: website_sale_renting
#. odoo-python
#: code:addons/website_sale_renting/models/sale_order.py:0
#, fuzzy
msgid ""
"\n"
"                Your rental product had invalid dates of pickup (%"
"(start_date)s) and\n"
"                return (%(end_date)s). Unfortunately, we do not process "
"pickups nor\n"
"                returns on those weekdays.\n"
"            "
msgstr ""
"                Datuma prevzema vašega izdelka za najem (%(start_date)s) in "
"vračila (%(end_date)s) nista veljavna.\n"
"                Na žalost ob teh dnevih v tednu ne izvajamo niti prevzemov "
"niti vračil.\n"
"            "

#. module: website_sale_renting
#. odoo-python
#: code:addons/website_sale_renting/models/sale_order.py:0
#, fuzzy
msgid ""
"\n"
"            Some of your rental products (%(product)s) cannot be rented "
"during the\n"
"            selected period and your cart must be updated. We're sorry for "
"the\n"
"            inconvenience.\n"
"        "
