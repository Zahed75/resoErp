msgstr "<code>employee</code>: ວັດຖຸ hr.employee"

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid "<code>inputs</code>: dict containing the computed inputs."
msgstr "<code>inputs</code>: dict ທີ່ບັນຈຸຂໍ້ມູນນຳເຂົ້າທີ່ຄິດໄລ່ແລ້ວ."

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid "<code>payslip</code>: hr.payslip object"
msgstr "<code>payslip</code>: ວັດຖຸ hr.payslip"

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid ""
"<code>result</code>: boolean True if the rule should be calculated, False "
"otherwise"
msgstr ""
"<code>result</code>: boolean True ຖ້າກົດເກນຄວນຖືກຄິດໄລ່, ຖ້າບໍ່ດັ່ງນັ້ນແມ່ນ False"

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid "<code>result</code>: float, base amount of the rule"
msgstr "<code>result</code>: float, ຈຳນວນເງິນພື້ນຖານຂອງກົດເກນ"

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid ""
"<code>result_name</code>: string, name of the line, which defaults to the "
"name field of the salary rule (useful if the name depends or should depend "
"on something computed in the rule)."
msgstr ""
"<code>result_name</code>: string, ຊື່ຂອງແຖວ, ເຊິ່ງຄ່າເລີ່ມຕົ້ນແມ່ນຊື່ຂອງກົດເກນເງິນເດືອນ."

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid "<code>result_qty</code>: float, quantity, which defaults to 1."
msgstr "<code>result_qty</code>: float, ຈຳນວນ, ເຊິ່ງຄ່າເລີ່ມຕົ້ນແມ່ນ 1."

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid ""
"<code>result_rate</code>: float, rate between -100.0 and 100.0, which "
"defaults to 100.0 (%)."
msgstr ""
"<code>result_rate</code>: float, ອັດຕາລະຫວ່າງ -100.0 ຫາ 100.0, ເຊິ່ງຄ່າເລີ່ມຕົ້ນແມ່ນ "
"100.0 (%)."

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid ""
"<code>result_rules</code>: dict containing the rules amounts, quantities, "
"rates and totals (previously computed)"
msgstr ""
"<code>result_rules</code>: dict ທີ່ບັນຈຸຈຳນວນ, ປະລິມານ, ອັດຕາ ແລະ ຍອດລວມຂອງກົດເກນ (ທີ່"
"ໄດ້ຄິດໄລ່ກ່ອນໜ້ານີ້)"

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid "<code>total = result * result_rate / 100 * result_qty</code>"
msgstr "<code>total = result * result_rate / 100 * result_qty</code>"

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid "<code>version</code>: hr.version object"
msgstr "<code>version</code>: ວັດຖຸ hr.version"

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid "<code>worked_days</code>: dict containing the computed worked days"
msgstr "<code>worked_days</code>: dict ທີ່ບັນຈຸຈຳນວນມື້ເຮັດວຽກທີ່ຄິດໄລ່ແລ້ວ"

