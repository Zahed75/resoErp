#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid ""
"<code>categories</code>: dict containing the computed salary rule categories "
"(sum of amount of all rules belonging to that category)."
msgstr ""
"<code>categories</code>: dict, съдържащ изчислените категории на правилата "
"за заплата (сумата от стойностите на всички правила, принадлежащи към тази "
"категория)."

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid "<code>employee</code>: hr.employee object"
msgstr "<code>employee</code>: обект hr.employee"

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid "<code>inputs</code>: dict containing the computed inputs."
msgstr "<code>inputs</code>: dict, съдържащ изчислените входни данни."

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid "<code>payslip</code>: hr.payslip object"
msgstr "<code>payslip</code>: обект hr.payslip"

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid ""
"<code>result</code>: boolean True if the rule should be calculated, False "
"otherwise"
msgstr ""
"<code>result</code>: boolean True, ако правилото трябва да се изчисли, в "
"противен случай False"

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid "<code>result</code>: float, base amount of the rule"
msgstr "<code>result</code>: float, базова стойност на правилото"

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid ""
"<code>result_name</code>: string, name of the line, which defaults to the "
"name field of the salary rule (useful if the name depends or should depend "
"on something computed in the rule)."
msgstr ""
"<code>result_name</code>: string, име на реда, което по подразбиране е името "
"на правилото за заплата (полезно, ако името зависи или трябва да зависи от "
"нещо, изчислено в правилото)."

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid "<code>result_qty</code>: float, quantity, which defaults to 1."
msgstr "<code>result_qty</code>: float, количество, което по подразбиране е 1."

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid ""
"<code>result_rate</code>: float, rate between -100.0 and 100.0, which "
"defaults to 100.0 (%)."
msgstr ""
"<code>result_rate</code>: float, процент между -100.0 и 100.0, който по "
"подразбиране е 100.0 (%)."

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid ""
"<code>result_rules</code>: dict containing the rules amounts, quantities, "
"rates and totals (previously computed)"
msgstr ""
"<code>result_rules</code>: dict, съдържащ стойностите, количествата, "
"процентите и сумите на правилата (изчислени по-рано)"

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid "<code>total = result * result_rate / 100 * result_qty</code>"
msgstr "<code>total = result * result_rate / 100 * result_qty</code>"

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid "<code>version</code>: hr.version object"
msgstr "<code>version</code>: обект hr.version"

#. module: hr_payroll
#: model_terms:ir.ui.view,arch_db:hr_payroll.hr_salary_rule_form
msgid "<code>worked_days</code>: dict containing the computed worked days"
msgstr "<code>worked_days</code>: dict, съдържащ изчислените отработени дни"

