<?xml version='1.0' encoding='utf-8'?>
<odoo noupdate="1">

    <record id="security_rule_whatsapp_register_phone" model="ir.rule">
        <field name="name">WA Register Phone: Restrict to Allowed Companies</field>
        <field name="model_id" ref="model_whatsapp_register_phone"/>
        <field name="domain_force">[('wa_account_id.allowed_company_ids', 'in', company_ids)]</field>
    </record>

    <record id="security_rule_whatsapp_register_phone_own" model="ir.rule">
        <field name="name">WA Register Phone: Restrict to Own</field>
        <field name="model_id" ref="model_whatsapp_register_phone"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>

</odoo>
