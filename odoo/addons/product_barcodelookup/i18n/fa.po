"                            As only 1000 products can be processed per day, "
"the remaining will be\n"
"                            done tomorrow.\n"
"                        </span>"
msgstr ""
"<span invisible=\"nb_products_selected &lt;= 1000\">\n"
"                            از آنجایی که در هر روز فقط 1000 محصول قابل "
"پردازش است، پردازش بقیه محصولات\n"
"                            فردا انجام خواهد شد.\n"
"                        </span>"

