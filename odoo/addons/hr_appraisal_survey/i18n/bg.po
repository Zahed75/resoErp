#. module: hr_appraisal_survey
#: model:mail.template,body_html:hr_appraisal_survey.mail_template_appraisal_ask_feedback
msgid ""
"<p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                    Dear <t t-out=\"object.partner_id.name or "
"'participant'\">[participant]</t>,\n"
"                    <br/>\n"
"                    As part of our 360° feedback process, <t t-"
"out=\"ctx.get('logged_user')\">[Current user]</t> would love\n"
"                    to get your insights on <t t-out=\"ctx.get('employee')"
"\">[the employee]</t>'s performance.\n"
"                    <br/>\n"
"                    Your feedback is valuable in helping us recognize "
"strengths and identify growth opportunities.\n"
"                    <br/>\n"
"                    It should only take a few minutes, and you can submit "
"your feedback via the link below:\n"
"                    <br/>\n"
"                    </p><div class=\"text-center my-4\">\n"
"                        <a t-att-href=\"object.get_start_url()\" t-attf-"
"style=\"background-color: {{user.company_id.email_secondary_color or "
"'#875A7B'}}; padding: 8px 16px 8px 16px; text-decoration: none; color: "
"{{user.company_id.email_primary_color or '#FFFFFF'}}; border-radius: 5px; "
"font-size:13px;\">\n"
"                            Give your feedback\n"
"                        </a>\n"
"                    </div>\n"
"                    Please complete the survey before <t t-"
"out=\"ctx.get('deadline')\">[the specified deadline]</t>.\n"
"                    <br/>\n"
"                    Thank you for your time and honesty!\n"
"                    <br/>\n"
"                    <t t-if=\"ctx.get('user_body')\">\n"
"                        <div class=\"my-3 py-2 px-3 bg-secondary\">\n"
"                            <t t-out=\"ctx.get('user_body')\">[Optional "
"comment]</t>\n"
"                        </div>\n"
"                    </t>\n"
"                \n"
"            "
msgstr ""
"<p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                    Уважаеми <t t-out=\"object.partner_id.name or "
"'participant'\">[participant]</t>,\n"
"                    <br/>\n"
"                    Като част от нашия процес за 360° обратна връзка, <t t-"
"out=\"ctx.get('logged_user')\">[Current user]</t> би искал(а)\n"
"                    да получи Вашето мнение за работата на <t t-out=\"ctx.get"
"('employee')\">[the employee]</t>.\n"
"                    <br/>\n"
"                    Вашата обратна връзка е ценна и ни помага да разпознаем "
"силните страни и да идентифицираме възможности за развитие.\n"
"                    <br/>\n"
"                    Това отнема само няколко минути и можете да изпратите "
"обратната си връзка чрез връзката по-долу:\n"
"                    <br/>\n"
"                    </p><div class=\"text-center my-4\">\n"
"                        <a t-att-href=\"object.get_start_url()\" t-attf-"
"style=\"background-color: {{user.company_id.email_secondary_color or "
"'#875A7B'}}; padding: 8px 16px 8px 16px; text-decoration: none; color: {"
"{user.company_id.email_primary_color or '#FFFFFF'}}; border-radius: 5px; "
"font-size:13px;\">\n"
"                            Дайте Вашата обратна връзка\n"
"                        </a>\n"
"                    </div>\n"
"                    Моля, попълнете анкетата преди <t t-out=\"ctx.get"
"('deadline')\">[the specified deadline]</t>.\n"
"                    <br/>\n"
"                    Благодарим Ви за отделеното време и откровеността!\n"
"                    <br/>\n"
"                    <t t-if=\"ctx.get('user_body')\">\n"
"                        <div class=\"my-3 py-2 px-3 bg-secondary\">\n"
"                            <t t-out=\"ctx.get('user_body')\">[Optional "
"comment]</t>\n"
"                        </div>\n"
"                    </t>\n"
"                \n"
"            "

