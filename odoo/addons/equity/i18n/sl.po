#. module: equity
#: model:mail.template,body_html:equity.equity_ubo_form_email_template
#, fuzzy
msgid ""
"<div>\n"
"                    <p> Hello <t t-out=\"object.name\"/>,<br/>\n"
"                        Following our legal obligations to identify clients, "
"we need to report natural persons who directly or indirectly\n"
"                        hold or control at least 25% in the capital or "
"voting rights of <b><t t-out=\"user_id.company_id.name\"/></b>. <br/> <br/>\n"
"                        Please fill in the UBO request:<br/>\n"
"                        <a t-attf-href=\"/my/ubo?"
"{{object._get_equity_url_params()}}\" class=\"btn btn-primary\">Fill UBO</a> "
"<br/> <br/>\n"
"                        Thank you,\n"
"                        <t t-if=\"user_id.signature\">\n"
"                            <br/>--<br/>\n"
"                            <t t-out=\"user_id.signature or ''\">Mitchell "
"Admin</t>\n"
"                        </t>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div>\n"
"                    <p> Pozdravljeni <t t-out=\"object.name\"/>,<br/>\n"
"                        V skladu z našimi zakonskimi obveznostmi glede "
"identifikacije strank moramo prijaviti fizične osebe, ki imajo neposredno "
"ali posredno v lasti ali obvladujejo vsaj 25 % kapitala ali glasovalnih "
"pravic družbe <b><t t-out=\"user_id.company_id.name\"/></b>. <br/> <br/>\n"
"                        Prosimo, izpolnite zahtevo UBO:<br/>\n"
"                        <a t-attf-href=\"/my/ubo?{"
"{object._get_equity_url_params()}}\" class=\"btn btn-primary\">Izpolni UBO</"
"a> <br/> <br/>\n"
"                        Hvala,\n"
"                        <t t-if=\"user_id.signature\">\n"
"                            <br/>--<br/>\n"
"                            <t t-out=\"user_id.signature or ''\">Mitchell "
"Admin</t>\n"
"                        </t>\n"
"                    </p>\n"
"                </div>\n"
"            "

