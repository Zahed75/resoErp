#. module: equity
#: model:mail.template,body_html:equity.equity_shareholder_email_template
msgid ""
"<div>\n"
"                    <p> Hello <t t-out=\"ctx.get('holder_name')\"/>,<br/>\n"
"                        You will find your latest transaction and valuations "
"in the following link: <br/>\n"
"                        <a t-attf-href=\"/my/equity?"
"access_token={{ctx.get('equity_access_token')}}\" class=\"btn btn-"
"primary\">Show Equity</a> <br/> <br/>\n"
"                        Best,\n"
"                        <t t-if=\"user_id.signature\">\n"
"                            <br/>--<br/>\n"
"                            <t t-out=\"user_id.signature or ''\">Mitchell "
"Admin</t>\n"
"                        </t>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div>\n"
"                    <p> سلام <t t-out=\"ctx.get('holder_name')\"/>،<br/>\n"
"                        می‌توانید آخرین تراکنش و ارزش‌گذاری‌های خود را در لینک "
"زیر مشاهده کنید: <br/>\n"
"                        <a t-attf-href=\"/my/equity?access_token={{ctx.get"
"('equity_access_token')}}\" class=\"btn btn-primary\">نمایش سهام</a> <br/> "
"<br/>\n"
"                        با احترام،\n"
"                        <t t-if=\"user_id.signature\">\n"
"                            <br/>--<br/>\n"
"                            <t t-out=\"user_id.signature or ''\">میکائیل "
"ادمین‌زاده</t>\n"
"                        </t>\n"
"                    </p>\n"
"                </div>\n"
"            "

#. module: equity
#: model:mail.template,body_html:equity.equity_ubo_form_email_template
msgid ""
"<div>\n"
"                    <p> Hello <t t-out=\"object.name\"/>,<br/>\n"
"                        Following our legal obligations to identify clients, "
"we need to report natural persons who directly or indirectly\n"
"                        hold or control at least 25% in the capital or "
"voting rights of <b><t t-out=\"user_id.company_id.name\"/></b>. <br/> <br/>\n"
"                        Please fill in the UBO request:<br/>\n"
"                        <a t-attf-href=\"/my/ubo?"
"{{object._get_equity_url_params()}}\" class=\"btn btn-primary\">Fill UBO</a> "
"<br/> <br/>\n"
"                        Thank you,\n"
"                        <t t-if=\"user_id.signature\">\n"
"                            <br/>--<br/>\n"
"                            <t t-out=\"user_id.signature or ''\">Mitchell "
"Admin</t>\n"
"                        </t>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div>\n"
"                    <p> سلام <t t-out=\"object.name\"/>،<br/>\n"
"                        در راستای تعهدات قانونی ما برای شناسایی مشتریان، "
"باید اشخاص حقیقی را که به‌طور مستقیم یا غیرمستقیم\n"
"                        مالک یا کنترل‌کننده حداقل 25% از سرمایه یا حق رأی <b>"
"<t t-out=\"user_id.company_id.name\"/></b> هستند، گزارش کنیم. <br/> <br/>\n"
"                        لطفاً درخواست ذینفع نهایی (UBO) را تکمیل کنید:<br/>\n"
"                        <a t-attf-href=\"/my/ubo?{"
"{object._get_equity_url_params()}}\" class=\"btn btn-primary\">تکمیل فرم "
"ذینفع نهایی</a> <br/> <br/>\n"
"                        با تشکر،\n"
"                        <t t-if=\"user_id.signature\">\n"
"                            <br/>--<br/>\n"
"                            <t t-out=\"user_id.signature or ''\">میکائیل "
"ادمین‌زاده</t>\n"
"                        </t>\n"
"                    </p>\n"
"                </div>\n"
"            "

