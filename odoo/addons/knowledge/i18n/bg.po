"        <span style=\"font-weight: bolder;\"><font class=\"text-o-"
"color-2\">Sections</font></span>:\n"
"    </span>"
msgstr ""
"<span style=\"font-size: 14px;\">\n"
"        <span style=\"font-weight: bolder;\">\n"
"            <font class=\"text-o-color-2\">Статиите</font>\n"
"        </span>\n"
