#. module: knowledge
#: model_terms:knowledge.article,template_body:knowledge.knowledge_article_template_marketing_campaign_brief
msgid ""
"<em>\n"
"                    <font class=\"text-600\">\n"
"                        Describe your campaign in just a few words.\n"
"                    </font>\n"
"                </em>"
msgstr ""
"<em>\n"
"                    <font class=\"text-600\">\n"
"                        کمپین خود را با چند کلمه توصیف کنید.\n"
"                    </font>\n"
"                </em>"

#. module: knowledge
#: model_terms:knowledge.article,template_body:knowledge.knowledge_article_template_marketing_campaign_brief
msgid ""
"<em>\n"
"                    <font class=\"text-600\">\n"
"                        How will your measure progress?\n"
"                    </font>\n"
"                </em>"
msgstr ""
"<em>\n"
"                    <font class=\"text-600\">\n"
"                        پیشرفت را چگونه اندازه‌گیری می‌کنید؟\n"
"                    </font>\n"
"                </em>"

#. module: knowledge
#: model_terms:knowledge.article,template_body:knowledge.knowledge_article_template_marketing_campaign_brief
msgid ""
"<em>\n"
"                    <font class=\"text-600\">\n"
"                        What are you trying to accomplish with this "
"campaign?\n"
"                    </font>\n"
"                </em>"
msgstr ""
"<em>\n"
"                    <font class=\"text-600\">\n"
"                        هدف شما از ایجاد این کمپین چیست؟\n"
"                    </font>\n"
"                </em>"

#. module: knowledge
#: model_terms:knowledge.article,template_body:knowledge.knowledge_article_template_marketing_campaign_brief
msgid ""
"<em>\n"
"                    <font class=\"text-600\">\n"
"                        What are you trying to convince them of?\n"
"                    </font>\n"
"                </em>"
msgstr ""
"<em>\n"
"                    <font class=\"text-600\">\n"
"                        می‌خواهید آنها را به چی متقاعد کنید؟\n"
"                    </font>\n"
"                </em>"

#. module: knowledge
#: model_terms:knowledge.article,template_body:knowledge.knowledge_article_template_marketing_campaign_brief
msgid ""
"<em>\n"
"                    <font class=\"text-600\">\n"
"                        Who are you trying to reach?\n"
"                    </font>\n"
"                </em>"
msgstr ""
"<em>\n"
"                    <font class=\"text-600\">\n"
"                        با چه کسی می‌خواهید ارتباط بگیرید؟\n"
"                    </font>\n"
"                </em>"

#. module: knowledge
#: model_terms:knowledge.article,template_body:knowledge.knowledge_article_template_software_specification
msgid ""
"<em>\n"
"                    <font class=\"text-600\">Ask a Senior Engineer to fill "
"this part before launching the task.</font>\n"
"                </em>"
msgstr ""
"<em>\n"
"                    <font class=\"text-600\">قبل از اجرای وظیفه، از یک مهندس "
"ارشد بخواهید این بخش را تکمیل کند.</font>\n"
"                </em>"

#. module: knowledge
#: model_terms:knowledge.article,template_body:knowledge.knowledge_article_template_software_specification
msgid ""
"<em>\n"
"                    <font class=\"text-600\">Ask the developer to go through "
"this checklist before asking for a review.</font>\n"
"                </em>"
msgstr ""
"<em>\n"
"                    <font class=\"text-600\">قبل از درخواست بازبینی، از یک "
"توسعه‌دهنده بخواهید این چک لیست را بررسی کند.</font>\n"
"                </em>"

#. module: knowledge
#: model_terms:knowledge.article,template_body:knowledge.knowledge_article_template_software_specification
msgid ""
"<em>\n"
"                    <font class=\"text-600\">Explain in a few words the "
"problem that this change is going to solve.</font>\n"
"                </em>"
msgstr ""
"<em>\n"
"                    <font class=\"text-600\">با چند کلمه مسئله‌ای که این "
"تغییر قرار است حل کند را شرح دهید.</font>\n"
"                </em>"

#. module: knowledge
#: model_terms:knowledge.article,template_body:knowledge.knowledge_article_template_software_specification
msgid ""
"<em>\n"
"                    <font class=\"text-600\">Explain in a single sentence "
"what has been changed.</font>\n"
"                </em>"
msgstr ""
"<em>\n"
"                    <font class=\"text-600\">در یک جمله توضیح دهید که چه "
"چیزی تغییر یافته است.</font>\n"
"                </em>"

#. module: knowledge
#: model_terms:knowledge.article,template_body:knowledge.knowledge_article_template_post_mortem
msgid ""
"<em>\n"
"                    <font class=\"text-600\">Explain the consequences of "
"this issue.</font>\n"
"                </em>"
msgstr ""
"<em>\n"
"                    <font class=\"text-600\">پیامدی که این مشکل دارد را "
"توضیح دهید.</font>\n"
"                </em>"

#. module: knowledge
#: model_terms:knowledge.article,template_body:knowledge.knowledge_article_template_post_mortem
msgid ""
"<em>\n"
"                    <font class=\"text-600\">Explain what went wrong in just "
"a few words.</font>\n"
"                </em>"
msgstr ""
"<em>\n"
"                    <font class=\"text-600\">با چند کلمه مشکلی که پیش آمده "
"است را شرح دهید.</font>\n"
"                </em>"

#. module: knowledge
#: model_terms:knowledge.article,template_body:knowledge.knowledge_article_template_post_mortem
msgid ""
"<em>\n"
"                    <font class=\"text-600\">How did it get to happen?</"
"font>\n"
"                </em>"
msgstr ""
"<em>\n"
"                    <font class=\"text-600\">چطور این اتفاق افتاد؟</font>\n"
"                </em>"

#. module: knowledge
#: model_terms:knowledge.article,template_body:knowledge.knowledge_article_template_post_mortem
msgid ""
"<em>\n"
"                    <font class=\"text-600\">How was it solved?</font>\n"
"                </em>"
msgstr ""
"<em>\n"
"                    <font class=\"text-600\">چگونه حل شد؟</font>\n"
"                </em>"

#. module: knowledge
#: model_terms:knowledge.article,template_body:knowledge.knowledge_article_template_software_specification
msgid ""
"<em>\n"
"                    <font class=\"text-600\">Lay here any remaining question "
"or doubt.</font>\n"
"                </em>"
msgstr ""
"<em>\n"
"                    <font class=\"text-600\">هر سؤال یا تردید دیگری که وجود "
"دارد را اینجا وارد کنید.</font>\n"
"                </em>"

#. module: knowledge
#: model_terms:knowledge.article,template_body:knowledge.knowledge_article_template_software_specification
msgid ""
"<em>\n"
"                    <font class=\"text-600\">List here all the changes to "
"implement.</font>\n"
"                </em>"
msgstr ""
"<em>\n"
"                    <font class=\"text-600\">در این قسمت تمام تغییرات "
"نیازمند پیاده‌سازی را وارد کنید.</font>\n"
"                </em>"

#. module: knowledge
#: model_terms:knowledge.article,template_body:knowledge.knowledge_article_template_software_specification
msgid ""
"<em>\n"
"                    <font class=\"text-600\">List here all the material and "
"documentation related to the task.</font>\n"
"                </em>"
msgstr ""
"<em>\n"
"                    <font class=\"text-600\">در این قسمت تمام محتوا و اسناد "
"مربوط به وظیفه را لیست کنید.</font>\n"
"                </em>"

#. module: knowledge
#: model_terms:knowledge.article,template_body:knowledge.knowledge_article_template_personal_organizer
msgid ""
"<em>\n"
"                    <font class=\"text-600\">List here all the text you "
"could not do this week. These shall be postponed in the next weekly schedule."
"</font>\n"
"                </em>"
msgstr ""
"<em>\n"
"                    <font class=\"text-600\">در این قسمت تمام متنی که این "
"هفته نتوانستید انجام دهید را وارد کنید. تمام این موارد به زمان‌بندی هفته بعد "
"موکول خواهند شد.</font>\n"
"                </em>"

#. module: knowledge
#: model_terms:knowledge.article,template_body:knowledge.knowledge_article_template_marketing_customer_personas
msgid ""
"<font class=\"text-400\">\n"
"                            <em>How to best reach this customer type.</em>\n"
"                        </font>"
msgstr ""
"<font class=\"text-400\">\n"
"                            <em>چگونه می‌توانیم به بهترین شیوه با این نوع "
"مشتری ارتباط بگیریم؟</em>\n"
"                        </font>"

#. module: knowledge
#: model_terms:knowledge.article,template_body:knowledge.knowledge_article_template_marketing_customer_persona_3
msgid ""
"<font class=\"text-400\">\n"
"                    <em>How to best reach this customer type.<br></em>\n"
"                </font>\n"
"                Abigail works a lot and never watches TV. Better reach her "
"on her phone or on her to work."
msgstr ""
"<font class=\"text-400\">\n"
"                    <em>بهترین راه برای دسترسی به این نوع مشتری.<br></em>\n"
"                </font>\n"
"                محمد زیاد کار می‌کند و هرگز تلویزیون تماشا نمی‌کند. بهتر است "
"از طریق تلفن یا محل کارش به او دسترسی پیدا کنید."

#. module: knowledge
#: model_terms:knowledge.article,template_body:knowledge.knowledge_article_template_marketing_customer_persona_4
msgid ""
"<font class=\"text-400\">\n"
"                    <em>How to best reach this customer type.<br></em>\n"
"                </font>\n"
"                As a classic Gen Z member, Vittorio never watches TV and "
"never listens to the radio. For him to see our message, we need to get to "
"his Instagram feed."
msgstr ""
"<font class=\"text-400\">\n"
"                    <em>بهترین راه برای رسیدن به این نوع مشتری.<br></em>\n"
"                </font>\n"
"                اسفندیار به عنوان یک عضو کلاسیک نسل زد، هرگز تلویزیون تماشا "
"نمی‌کند و هرگز به رادیو گوش نمی‌دهد. برای اینکه پیام ما را ببیند، باید به فید "
"اینستاگرام او برسیم."

#. module: knowledge
#: model_terms:knowledge.article,template_body:knowledge.knowledge_article_template_marketing_customer_persona_1
msgid ""
"<font class=\"text-400\">\n"
"                    <em>How to best reach this customer type.<br></em>\n"
"                </font>\n"
"                As an avid music listener, the best way to reach Sonya is "
"through the radio since hers is always on."
msgstr ""
"<font class=\"text-400\">\n"
"                    <em>بهترین راه برای رسیدن به این نوع مشتری.<br></em>\n"
"                </font>\n"
"                آتوسا به عنوان یک شنونده موسیقی مشتاق، بهترین راه برای رسیدن "
"به او از طریق رادیو است زیرا رادیوی او همیشه روشن است."

#. module: knowledge
#: model_terms:knowledge.article,template_body:knowledge.knowledge_article_template_marketing_customer_persona_2
msgid ""
"<font class=\"text-400\">\n"
"                    <em>How to best reach this customer type.<br></em>\n"
"                </font>\n"
"                Julius follows politics very tightly, and can best be "
"reached with TV ads."
msgstr ""
"<font class=\"text-400\">\n"
"                    <em>بهترین روش ارتباط با این نوع مشتری.<br></em>\n"
"                </font>\n"
"                فرزانه سیاست را خیلی نزدیک دنبال می‌کند و بهترین راه برای "
"ارتباط با او تبلیغات تلویزیونی است."

