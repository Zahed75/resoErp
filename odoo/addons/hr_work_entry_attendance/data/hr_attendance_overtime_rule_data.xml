        </record>

        <record id="hr_attendance.hr_attendance_overtime_rule_3_ae" model="hr.attendance.overtime.rule">
            <field name="work_entry_type_id" ref="hr_work_entry.uae_work_entry_type_overtime_work_days_nighttime"/>
            <field name="paid">True</field>
        </record>

        <record id="hr_attendance.hr_attendance_overtime_rule_4_ae" model="hr.attendance.overtime.rule">
            <field name="work_entry_type_id" ref="hr_work_entry.uae_work_entry_type_overtime_off_days"/>
