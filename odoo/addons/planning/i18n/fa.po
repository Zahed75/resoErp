"href=\"ctx['google_url']\" target=\"_blank\" "
"class=\"planning_mail_template_button\">Add to Google Calendar</a>\n"
"                        <a t-if=\"ctx.get('iCal_url')\" t-att-"
"href=\"ctx['iCal_url']\" target=\"_blank\" "
"class=\"planning_mail_template_button\">Add to iCal/Outlook</a>\n"
"                    </div>\n"
"                    <br/>\n"
"                    <p t-if=\"ctx.get('open_shift_available')\">If you are "
"interested and available, please assign yourself this open shift.</p>\n"
"                    <p t-else=\"\">In case the current shift doesn't suit "
"you, we encourage you to reach out to your colleagues and request to switch "
"shifts. They might be interested in exchanging shifts with you.</p>\n"
"                </div>\n"
"            </body>"
msgstr ""
"<style>\n"
"                    .planning_mail_template_button {\n"
"                        padding: 5px 10px;\n"
"                        text-decoration: none;\n"
"                        border: 1px;\n"
"                        border-radius: 3px;\n"
"                        text-align: center;\n"
"                        color: #374151;\n"
"                        background-color: #E7E9ED;\n"
"                        border: solid #E7E9ED;\n"
"                        flex: 1 1 40%;\n"
"                    }\n"
"                    .top_button {\n"
"                        color: #FFFFFF;\n"
"                        background-color: #714B67;\n"
"                        border: solid #714B67;\n"
"                        flex: 1 1 60%;\n"
"                    }\n"
"                    .button_box {\n"
"                        display: flex;\n"
"                        flex-wrap: wrap;\n"
"                        gap: 10px;\n"
"                        margin: 20px 15px 0px 15px;\n"
"                    }\n"
"                </style>\n"
"                <body dir=\"rtl\" style=\"font-family:IRANSans, IRANSansX, "
"Arial,sans-serif\"><div>\n"
"                    <p t-if=\"ctx.get('employee_name')\"><t t-"
"out=\"ctx['employee_name']\">آفتاب حقانی</t> گرامی</p>\n"
"                    <p t-else=\"\">با سلام،</p>\n"
"                    <br/>\n"
"                    <p t-if=\"ctx.get('open_shift_available')\">شیفت آزاد "
"جدیدی در دسترس است:</p>\n"
"                    <p t-else=\"\">شما به این شیفت اختصاص یافتید:</p>\n"
"                    <table style=\"margin-left: 30px;\">\n"
"                        <tr t-if=\"(ctx.get('start_datetime') and ctx.get"
"('end_datetime'))                                   or ctx.get"
"('allocated_hours')                                   or ctx.get"
"('allocated_percentage')\">\n"
"                            <th style=\"padding: 5px; text-align: left;\">"
"تاریخ</th>\n"
"                            <td style=\"padding: 5px;\">\n"
"                                <span t-if=\"ctx.get('start_datetime') and "
"ctx.get('end_datetime')\" t-out=\"'%s ⟶ %s' % "
"(                                     "
"ctx['start_datetime'],                                     "
"ctx['end_datetime'],                                 )\">\n"
"                                    1403/08/06, 8:00 AM ⟶ 1403/08/6, 4:00 "
"PM\n"
"                                </span>\n"
"                                <span t-if=\"ctx.get('allocated_hours')\" "
"style=\"opacity: 0.5;\">\n"
"                                    (<t t-out=\"ctx['allocated_hours']\">"
"4:00</t>h)\n"
"                                </span>\n"
"                                <span t-if=\"ctx.get('allocated_percentage') "
"and ctx['allocated_percentage'] != '100'\" style=\"opacity: 0.5;\">\n"
"                                    (<t t-"
"out=\"ctx['allocated_percentage']\">50</t>%)\n"
"                                </span>\n"
"                            </td>\n"
"                        </tr>\n"
"                        <tr t-if=\"object.role_id\">\n"
"                            <th style=\"padding: 5px; text-align: left;\">"
"نقش</th>\n"
"                            <td style=\"padding: 5px;\" t-"
"out=\"object.role_id.name or ''\">متصدی</td>\n"
"                        </tr>\n"
"                        <tr t-if=\"hasattr(object, 'project_id') and "
"object.project_id\">\n"
"                            <th style=\"padding: 5px; text-align: left;\">"
"پروژه</th>\n"
"                            <td style=\"padding: 5px;\" t-out=\"object.sudo()"
".project_id.name or ''\">جمع‌آوری داده</td>\n"
"                        </tr>\n"
"                        <tr t-if=\"hasattr(object, 'sale_line_id') and "
"object.sale_line_id\">\n"
"                            <th style=\"padding: 5px; text-align: left;\">"
"آیتم سفارش فروش</th>\n"
"                            <td style=\"padding: 5px;\" t-out=\"object.sudo()"
".sale_line_id.name or ''\">قهوه</td>\n"
"                        </tr>\n"
"                        <tr t-if=\"hasattr(object, 'name') and object.name\">"
"\n"
"                            <th style=\"padding: 5px; text-align: left;\">"
"یادداشت</th>\n"
"                            <td style=\"padding: 5px;\" t-out=\"object.name "
"or ''\">/</td>\n"
"                        </tr>\n"
"                    </table>\n"
"                    <div class=\"button_box\">\n"
"                        <a t-if=\"ctx.get('available_link')\" t-att-"
"href=\"ctx['available_link']\" target=\"_blank\" "
"class=\"planning_mail_template_button top_button\">شیفت را قبول می‌کنم</a>\n"
"                        <a t-if=\"ctx.get('unavailable_link')\" t-att-"
"href=\"ctx['unavailable_link']\" target=\"_blank\" "
"class=\"planning_mail_template_button top_button\">در دسترس نیستم</a>\n"
"                        <a t-if=\"ctx.get('google_url')\" t-att-"
"href=\"ctx['google_url']\" target=\"_blank\" "
"class=\"planning_mail_template_button\">افزودن به تقویم گوگل</a>\n"
"                        <a t-if=\"ctx.get('iCal_url')\" t-att-"
"href=\"ctx['iCal_url']\" target=\"_blank\" "
"class=\"planning_mail_template_button\">افزودن به iCal/اوت‌لوک</a>\n"
"                    </div>\n"
"                    <br/>\n"
"<p t-if=\"ctx.get('open_shift_available')\">اگر علاقه‌مند و در دسترس هستید، "
"لطفاً خود را به شیفت آزاد اختصاص دهید.</p>\n"
"<p t-else=\"\">در صورتی که شیفت فعلی مناسب شما نیست، توصیه می‌کنیم با "
"همکارانتان تماس بگیرید و درخواست جابه‌جایی شیفت دهید. ممکن است آن‌ها نیز "
"علاقه‌مند به تعویض شیفت با شما باشند.</p>\n"
"</div>\n"
"            </body>"

#. module: planning
#: model:mail.template,body_html:planning.email_template_planning_planning
msgid ""
"<style>\n"
"                .planning_mail_template_button {\n"
"                    padding: 5px 10px;\n"
"                    text-decoration: none;\n"
"                    border: 1px;\n"
"                    border-radius: 3px;\n"
"                    display: inline-block; \n"
"                    width: 190px;\n"
"                    text-align: center;\n"
"                }\n"
"                </style>\n"
"                <body><div>\n"
"                    <p t-if=\"ctx.get('employee')\">Dear <t t-"
"out=\"ctx['employee'].name or ''\">Anita Oliver</t>,</p>\n"
"                    <p t-else=\"\">Hello,</p>\n"
"                    <br/>\n"
"                    <p t-if=\"ctx.get('start_datetime') and "
"ctx.get('end_datetime')\">\n"
"                        Your upcoming shifts from <t t-"
"out=\"format_date(ctx['start_datetime'])\">05-05-2021</t>\n"
"                        to <t t-out=\"format_date(ctx['end_datetime'])"
"\">05-11-2021</t> have been published.\n"
"                    </p>\n"
"                    <div style=\"display: flex; margin: 15px;\">\n"
"                        <div t-if=\"ctx.get('planning_url')\" style=\"margin-"
"right: 15px;\">\n"
"                            <a t-att-href=\"ctx['planning_url']\" "
"target=\"_blank\" class=\"planning_mail_template_button\" t-attf-"
"style=\"color: {{object.company_id.email_primary_color or '#FFFFFF'}}; "
"background-color: {{object.company_id.email_secondary_color or '#875A7B'}};"
"\">View Your Planning</a>\n"
"                        </div>\n"
"                        <div t-if=\"ctx.get('planning_url_ics')\">\n"
"                            <a t-att-href=\"ctx['planning_url_ics']\" "
"target=\"_blank\" class=\"planning_mail_template_button\" style=\"color: "
"#374151; background-color: #E7E9ED; border: solid #E7E9ED;\">Add to "
"Calendar</a>\n"
"                        </div>\n"
"                    </div>\n"
"                    <br/>\n"
"                    <p t-if=\"ctx.get('slot_unassigned') or "
"(object.allow_self_unassign and object.self_unassign_days_before)\">\n"
"                        <t t-if=\"ctx.get('slot_unassigned')\">\n"
"                            We would also like to remind you that there are "
"some open shifts available, and if you are interested and available, please "
"assign yourself to those shifts.\n"
"                        </t>\n"
"                        <t t-if=\"object.allow_self_unassign and "
"object.self_unassign_days_before\">\n"
"                            If you are unable to work a shift that has been "
"assigned to you, please unassign yourself within <t t-"
"out=\"object.self_unassign_days_before or ''\">5</t> day(s) before the start "
"of the shift.\n"
"                        </t>\n"
"                    </p>\n"
"                    <p t-if=\"ctx.get('message')\" t-out=\"ctx['message']\"/"
">\n"
"                    <p t-if=\"object.allow_self_unassign\">In case your "
"current schedule doesn't suit you, we encourage you to reach out to your "
"colleagues and request to switch shifts. They might be interested in "
"exchanging shifts with you.</p>\n"
"                </div>\n"
"            </body>"
msgstr ""
"<style>\n"
"    .planning_mail_template_button {\n"
"        padding: 5px 10px;\n"
"        text-decoration: none;\n"
"        border: 1px;\n"
"        border-radius: 3px;\n"
"        display: inline-block; \n"
"        width: 190px;\n"
"        text-align: center;\n"
"    }\n"
"</style>\n"
"<body dir=\"rtl\" style=\"font-family: IRANSans, IRANSansX, Arial, sans-"
"serif;\">\n"
"    <div>\n"
"        <p t-if=\"ctx.get('employee')\"><t t-out=\"ctx['employee'].name or "
"''\">آفتاب حقانی</t> گرامی،</p>\n"
"        <p t-else=\"\">با سلام و احترام،</p>\n"
"        <br/>\n"
"        <p t-if=\"ctx.get('start_datetime') and ctx.get('end_datetime')\">\n"
"            شیفت آینده شما از <t t-out=\"format_date(ctx['start_datetime'])"
"\">1402/05/06</t>\n"
"            تا <t t-out=\"format_date(ctx['end_datetime'])\">1402/07/06</t> "
"منتشر شد.\n"
"        </p>\n"
"        <div style=\"display: flex; margin: 15px;\">\n"
"            <div t-if=\"ctx.get('planning_url')\" style=\"margin-left: "
"15px;\">\n"
"                <a t-att-href=\"ctx['planning_url']\" target=\"_blank\" "
"class=\"planning_mail_template_button\" t-attf-style=\"color: {"
"{object.company_id.email_primary_color or '#FFFFFF'}}; background-color: {"
"{object.company_id.email_secondary_color or '#875A7B'}};\">مشاهده زمان‌بندی</"
"a>\n"
"            </div>\n"
"            <div t-if=\"ctx.get('planning_url_ics')\">\n"
"                <a t-att-href=\"ctx['planning_url_ics']\" target=\"_blank\" "
"class=\"planning_mail_template_button\" style=\"color: #374151; background-"
"color: #E7E9ED; border: solid #E7E9ED;\">افزودن به تقویم</a>\n"
"            </div>\n"
"        </div>\n"
"        <br/>\n"
"        <p t-if=\"ctx.get('slot_unassigned') or (object.allow_self_unassign "
"and object.self_unassign_days_before)\">\n"
"            <t t-if=\"ctx.get('slot_unassigned')\">\n"
"                همچنین یادآوری می‌کنیم که چند شیفت باز موجود است و در صورت "
"تمایل و در دسترس بودن، لطفاً خود را به این شیفت‌ها اختصاص دهید.\n"
"            </t>\n"
"            <t t-if=\"object.allow_self_unassign and "
"object.self_unassign_days_before\">\n"
"                در صورتی که نمی‌توانید شیفتی را که به شما اختصاص داده شده است "
"انجام دهید، لطفاً حداقل <t t-out=\"object.self_unassign_days_before or ''\">"
"5</t> روز قبل از شروع شیفت، خود را از آن شیفت خارج کنید.\n"
"            </t>\n"
"        </p>\n"
"        <p t-if=\"ctx.get('message')\" t-out=\"ctx['message']\"/>\n"
"        <p t-if=\"object.allow_self_unassign\">\n"
"            اگر برنامه فعلی شما مناسب نیست، توصیه می‌کنیم با همکارانتان تماس "
"بگیرید و درخواست جابه‌جایی شیفت دهید. ممکن است آن‌ها نیز علاقه‌مند به تعویض شیفت "
"با شما باشند.\n"
"        </p>\n"
"    </div>\n"
"</body>\n"
" "

