<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- One-click demo data seed (idempotent; safe to click twice). -->
    <record id="action_seed_ownership_demo" model="ir.actions.server">
        <field name="name">Generate Demo Data</field>
        <field name="model_id" ref="model_rcloud_owner"/>
        <field name="state">code</field>
        <field name="code">action = env['rcloud.owner']._load_demo_data()</field>
    </record>
    <menuitem id="menu_ownership_demo_seed" name="Generate Demo Data"
        parent="menu_ownership_root" action="action_seed_ownership_demo"
        groups="rcloud_base.group_hotel_manager" sequence="100"/>
</odoo>
