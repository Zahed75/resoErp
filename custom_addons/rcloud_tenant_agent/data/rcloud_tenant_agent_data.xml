<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Phone home to the control plane every 6 hours. -->
    <record id="ir_cron_rcloud_phone_home" model="ir.cron">
        <field name="name">Resort Cloud: entitlement phone-home</field>
        <field name="model_id" ref="model_rcloud_tenant_agent_agent"/>
        <field name="state">code</field>
        <field name="code">model.phone_home()</field>
        <field name="interval_number">6</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
