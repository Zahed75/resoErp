<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================= Guest Folio Statement ================= -->
    <record id="action_report_folio" model="ir.actions.report">
        <field name="name">Guest Folio Statement</field>
        <field name="model">rcloud.folio</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">rcloud_pms_account.report_folio</field>
        <field name="report_file">rcloud_pms_account.report_folio</field>
        <field name="binding_model_id" ref="rcloud_pms.model_rcloud_folio"/>
        <field name="binding_type">report</field>
    </record>
    <template id="report_folio">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company"
                   t-value="o.property_id.company_id or o.partner_id.company_id or o.env.company"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <t t-set="prop" t-value="o.property_id"/>
                        <t t-set="res" t-value="o.reservation_id"/>
                        <!-- A4 header (UIdesign 07): 2px ink rule, brand left, doc identity right -->
                        <div style="display:flex;justify-content:space-between;border-bottom:2px solid #1C2536;padding-bottom:4mm;margin-bottom:5mm;">
                            <div>
                                <div t-if="prop" t-field="prop.name" style="font-size:14pt;font-weight:700;color:#1C2536;"/>
                                <div t-if="prop" style="font-size:8pt;color:#667085;">
                                    <span t-field="prop.street"/>
                                    <span t-if="prop.street2">, <span t-field="prop.street2"/></span>
                                    <span t-if="prop.city">, <span t-field="prop.city"/></span>
                                    <span t-if="prop.phone"> · <span t-field="prop.phone"/></span>
                                    <span t-if="prop.email"> · <span t-field="prop.email"/></span>
                                </div>
                                <div style="font-family:'JetBrains Mono',monospace;font-size:7.5pt;color:#667085;">
                                    <t t-if="prop and prop.company_id.vat">VAT/BIN <span t-field="prop.company_id.vat"/></t>
                                </div>
                            </div>
                            <div style="text-align:right;">
                                <div style="font-size:9pt;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:#1C2536;">Guest Folio Statement</div>
                                <div style="font-family:'JetBrains Mono',monospace;font-size:8pt;color:#1C2536;" t-field="o.name"/>
                                <div style="font-size:7.5pt;color:#667085;">Issued <span t-esc="(o.write_date or o.create_date).date()"/></div>
                            </div>
                        </div>
                        <!-- Info band: Guest / Stay / Booking -->
                        <div style="display:flex;gap:8mm;margin-bottom:5mm;font-size:8.5pt;color:#1C2536;">
                            <div style="flex:1;">
                                <div style="font-size:7.5pt;text-transform:uppercase;color:#667085;letter-spacing:.5px;">Guest</div>
                                <strong t-field="o.partner_id"/>
                            </div>
                            <div style="flex:1;">
                                <div style="font-size:7.5pt;text-transform:uppercase;color:#667085;letter-spacing:.5px;">Stay</div>
                                <span t-if="res" t-field="res.arrival"/> → <span t-if="res" t-field="res.departure"/><br/>
                                <span t-if="res and res.room_id">Room <span t-field="res.room_id"/></span>
                                <span t-if="res" style="font-family:'JetBrains Mono',monospace;font-size:7.5pt;color:#667085;"> · <span t-field="res.name"/></span>
                            </div>
                            <div style="flex:1;">
                                <div style="font-size:7.5pt;text-transform:uppercase;color:#667085;letter-spacing:.5px;">Nights</div>
                                <span t-if="res" t-esc="(res.departure - res.arrival).days"/>
                                <span t-if="not res">—</span>
                            </div>
                        </div>
                        <t t-set="charges" t-value="o.line_ids.sorted('date').sorted('source')"/>
                        <table class="table table-sm table-striped mt-3">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Description</th>
                                    <th class="text-end">Qty</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="last_source" t-value="False"/>
                                <t t-foreach="charges" t-as="line">
                                    <t t-if="line.source != last_source">
                                        <t t-set="last_source" t-value="line.source"/>
                                        <tr>
                                            <td colspan="5" class="fw-bold">
                                                <span t-field="line.source"/>
                                            </td>
                                        </tr>
                                    </t>
                                    <tr>
                                        <td><span t-field="line.date"/></td>
                                        <td><span t-field="line.description"/></td>
                                        <td class="text-end"><span t-field="line.qty"/></td>
                                        <td class="text-end"><span t-field="line.unit_price"/></td>
                                        <td class="text-end"><span t-field="line.amount"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <t t-set="subtotal" t-value="sum(charges.mapped('amount'))"/>
                        <t t-set="tax_total" t-value="0"/>
                        <t t-foreach="charges" t-as="line">
                            <t t-set="tax_total"
                               t-value="tax_total + line.amount * sum(line.tax_ids.mapped('amount')) / 100"/>
                        </t>
                        <t t-set="payments" t-value="sum(o.invoice_ids.mapped('amount_total')) - sum(o.invoice_ids.mapped('amount_residual'))"/>
                        <div class="row">
                            <div class="col-6">
                                <table class="table table-sm" t-if="charges.mapped('tax_ids')">
                                    <thead><tr><th>Tax</th><th class="text-end">Rate</th>
                                        <th class="text-end">Base</th><th class="text-end">Amount</th></tr></thead>
                                    <tbody>
                                        <t t-set="seen_taxes" t-value="[]"/>
                                        <t t-foreach="charges.mapped('tax_ids')" t-as="tax">
                                            <t t-if="tax.id not in [t.id for t in seen_taxes]">
                                                <t t-set="seen_taxes" t-value="seen_taxes + [tax]"/>
                                                <t t-set="base" t-value="sum(l.amount for l in charges if tax in l.tax_ids)"/>
                                                <tr>
                                                    <td><span t-field="tax.name"/></td>
                                                    <td class="text-end"><span t-field="tax.amount"/>%</td>
                                                    <td class="text-end"><span t-esc="base"/></td>
                                                    <td class="text-end"><span t-esc="base * tax.amount / 100"/></td>
                                                </tr>
                                            </t>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                            <div class="col-6">
                                <!-- Boxed totals panel (UIdesign 07) -->
                                <table class="table table-sm" style="border:1.5px solid #1C2536;">
                                    <tr><td style="font-size:8.5pt;">Subtotal</td><td class="text-end" style="font-variant-numeric:tabular-nums;"><span t-esc="subtotal"/></td></tr>
                                    <tr><td style="font-size:8.5pt;">Taxes</td><td class="text-end" style="font-variant-numeric:tabular-nums;"><span t-esc="tax_total"/></td></tr>
                                    <tr style="font-weight:700;"><td>Total</td><td class="text-end" style="font-variant-numeric:tabular-nums;"><span t-esc="subtotal + tax_total"/></td></tr>
                                    <tr><td style="font-size:8.5pt;">Payments Applied</td><td class="text-end" style="color:#00635C;font-variant-numeric:tabular-nums;">− <span t-esc="payments"/></td></tr>
                                    <tr style="font-weight:700;">
                                        <td style="font-size:9pt;text-transform:uppercase;letter-spacing:.5px;">Balance Due</td>
                                        <td class="text-end" t-attf-style="font-size:12pt;font-weight:700;font-variant-numeric:tabular-nums;color:{{' #C13333' if (subtotal + tax_total - payments) > 0 else '#00635C'}};"><span t-esc="subtotal + tax_total - payments"/></td>
                                    </tr>
                                </table>
                                <div style="font-size:7.5pt;color:#667085;margin-top:2mm;">
                                    Settled in full — no further amount is payable —
                                    <span t-if="(subtotal + tax_total - payments) > 0">balance due on departure.</span>
                                    <span t-if="not (subtotal + tax_total - payments) > 0">thank you for staying with us.</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- ================= Tax Invoice ================= -->
    <record id="action_report_tax_invoice" model="ir.actions.report">
        <field name="name">Tax Invoice</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">rcloud_pms_account.report_tax_invoice</field>
        <field name="report_file">rcloud_pms_account.report_tax_invoice</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>
    <template id="report_tax_invoice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="text-center">
                            <h3>TAX INVOICE</h3>
                            <div>Invoice No: <span t-field="o.name"/></div>
                            <div t-if="company.vat">VAT: <span t-field="company.vat"/></div>
                        </div>
                        <div class="row mt-4">
                            <div class="col-6">
                                <strong>Bill To:</strong><br/>
                                <span t-field="o.partner_id"/><br/>
                                <span t-if="o.partner_id.vat">VAT: <span t-field="o.partner_id.vat"/></span>
                            </div>
                            <div class="col-6 text-end">
                                <strong>Invoice Date:</strong> <span t-field="o.invoice_date"/><br/>
                                <strong>Due Date:</strong> <span t-field="o.invoice_date_due"/><br/>
                                <strong>Reference:</strong> <span t-field="o.invoice_origin"/>
                            </div>
                        </div>
                        <table class="table table-sm table-striped mt-3">
                            <thead>
                                <tr>
                                    <th>Description</th>
                                    <th class="text-end">Qty</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Taxes</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.invoice_line_ids" t-as="line">
                                    <td><span t-field="line.name"/></td>
                                    <td class="text-end"><span t-field="line.quantity"/></td>
                                    <td class="text-end"><span t-field="line.price_unit"/></td>
                                    <td class="text-end">
                                        <span t-field="line.tax_ids" t-options="{'widget': 'many2many_tags'}"/>
                                    </td>
                                    <td class="text-end"><span t-field="line.price_total"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="row">
                            <div class="col-6">
                                <table class="table table-sm" t-if="o.invoice_line_ids.mapped('tax_ids')">
                                    <thead><tr><th>Tax</th><th class="text-end">Rate</th>
                                        <th class="text-end">Base</th><th class="text-end">Amount</th></tr></thead>
                                    <tbody>
                                        <t t-set="seen_taxes" t-value="[]"/>
                                        <t t-foreach="o.invoice_line_ids.mapped('tax_ids')" t-as="tax">
                                            <t t-if="tax.id not in [t.id for t in seen_taxes]">
                                                <t t-set="seen_taxes" t-value="seen_taxes + [tax]"/>
                                                <t t-set="base" t-value="sum(l.price_subtotal for l in o.invoice_line_ids if tax in l.tax_ids)"/>
                                                <tr>
                                                    <td><span t-field="tax.name"/></td>
                                                    <td class="text-end"><span t-field="tax.amount"/>%</td>
                                                    <td class="text-end"><span t-esc="base"/></td>
                                                    <td class="text-end"><span t-esc="base * tax.amount / 100"/></td>
                                                </tr>
                                            </t>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                            <div class="col-6">
                                <table class="table table-sm">
                                    <tr><td>Untaxed Amount</td><td class="text-end"><span t-field="o.amount_untaxed"/></td></tr>
                                    <tr><td>Taxes</td><td class="text-end"><span t-field="o.amount_tax"/></td></tr>
                                    <tr class="fw-bold"><td>Total</td><td class="text-end"><span t-field="o.amount_total"/></td></tr>
                                    <tr><td>Amount Due</td><td class="text-end"><span t-field="o.amount_residual"/></td></tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
