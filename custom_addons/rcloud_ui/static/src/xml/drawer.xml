<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rcloud_ui.Drawer">
        <button class="rc-drawer-toggle" t-on-click="toggle" aria-label="Apps menu" title="Apps">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                <path d="M3,6H21V8H3V6M3,11H21V13H3V11M3,16H21V18H3V16Z"/>
            </svg>
        </button>
        <t t-if="state.open">
            <div class="rc-drawer-overlay" t-on-click="close"/>
            <div class="rc-drawer" role="dialog" aria-label="Applications">
                <div class="rc-drawer-search">
                    <input type="text" placeholder="Search apps…" t-on-input="onSearch" t-att-value="state.filter"/>
                </div>
                <div class="rc-drawer-body">
                    <t t-foreach="grouped" t-as="group" t-key="group.label">
                        <div class="rc-drawer-group" t-esc="group.label"/>
                        <t t-foreach="group.apps" t-as="app" t-key="app.xmlid or app.id">
                            <button class="rc-drawer-item" t-on-click="() => this.openApp(app)">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                                    <t t-att-d="iconFor(app.name)"/>
                                </svg>
                                <t t-esc="app.name"/>
                            </button>
                        </t>
                    </t>
                    <div class="rc-empty" style="padding:16px;" t-if="!apps.length">No apps match your search.</div>
                </div>
                <div class="rc-drawer-foot">Resort Cloud · one guest record, one folio, everywhere</div>
            </div>
        </t>
    </t>
</templates>
