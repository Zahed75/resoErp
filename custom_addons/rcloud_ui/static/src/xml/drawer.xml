<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Hamburger lives at the FAR LEFT of the top bar (nav shell spec) —
         it REPLACES the enterprise app-grid toggle, which is hidden. The
         brand click opens the PMS dashboard instead of the app grid. -->
    <t t-name="rcloud_ui.NavBarExtension" t-inherit="web_enterprise.EnterpriseNavBar" t-inherit-mode="extension">
        <xpath expr="//a[hasclass('o_menu_toggle')][1]" position="before">
            <RcloudDrawerToggle/>
        </xpath>
        <xpath expr="//a[hasclass('o_menu_toggle')][1]" position="attributes">
            <attribute name="t-on-click.prevent">() => this.openAppHome()</attribute>
        </xpath>
    </t>

    <!-- ONE global app drawer: apps are the main menu; each app expands to
         show its own submenus (SaaS-style dropdown drawer). -->
    <t t-name="rcloud_ui.Drawer">
        <button class="rc-drawer-toggle" t-on-click="toggle" aria-label="Apps menu" title="Apps">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                <path d="M3,6H21V8H3V6M3,11H21V13H3V11M3,16H21V18H3V16Z"/>
            </svg>
        </button>
        <t t-if="state.open">
            <div class="rc-drawer-overlay" t-on-click="close"/>
            <div class="rc-drawer" role="dialog" aria-label="Applications">
                <div class="rc-drawer-search">
                    <input type="text" placeholder="Search apps…" t-on-input="onSearch" t-att-value="state.filter"/>
                </div>
                <div class="rc-drawer-body">
                    <t t-foreach="apps" t-as="app" t-key="app.xmlid or app.id">
                        <div class="rc-drawer-row" t-att-class="{expanded: isExpanded(app)}">
                            <button class="rc-drawer-item" t-on-click="() => this.openApp(app)">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                                    <path t-att-d="iconFor(app.name)"/>
                                </svg>
                                <span class="rc-drawer-label" t-esc="app.name"/>
                            </button>
                            <button class="rc-drawer-expander" t-if="hasChildren(app)"
                                    t-att-aria-label="isExpanded(app) ? 'Collapse' : 'Expand'"
                                    t-on-click="() => this.toggleExpand(app)">
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                                    <path t-if="!isExpanded(app)" d="M6 9l6 6 6-6"/>
                                    <path t-if="isExpanded(app)" d="M18 15l-6-6-6 6"/>
                                </svg>
                            </button>
                        </div>
                        <div class="rc-drawer-submenu" t-if="isExpanded(app)">
                            <t t-foreach="menuTree(app)" t-as="g" t-key="g.id">
                                <div class="rc-drawer-group" t-esc="g.label"/>
                                <button class="rc-drawer-subitem" t-foreach="g.items" t-as="item" t-key="item.id"
                                        t-att-class="{active: isActive(item)}"
                                        t-on-click="() => this.openMenu(item, app)">
                                    <t t-esc="item.name"/>
                                </button>
                            </t>
                        </div>
                    </t>
                    <div class="rc-empty" style="padding:16px;" t-if="!apps.length">No apps match your search.</div>
                </div>
                <div class="rc-drawer-foot">
                    <div class="rc-drawer-actions">
                        <button t-on-click="() => this.openAppsManager()">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M10.59,9.17L5.41,4L4,5.41L9.17,10.58L10.59,9.17M14.5,4L16.54,6.04L4,18.59L5.41,20L17.96,7.46L20,9.5V4M14.83,13.41L13.42,14.82L16.55,17.95L14.5,20H20V14.5L17.96,16.54L14.83,13.41Z"/></svg>
                            Install Apps
                        </button>
                        <button t-on-click="() => this.openSettings()">
                            <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.4,13C19.5,12.7 19.5,12.4 19.5,12C19.5,11.6 19.5,11.3 19.4,11L21.5,9.4L19.5,6.6L17,7.5C16.4,7 15.7,6.6 15,6.3L14.7,3.8H11.3L11,6.3C10.3,6.6 9.6,7 9,7.5L6.5,6.6L4.5,9.4L6.6,11C6.5,11.3 6.5,11.6 6.5,12C6.5,12.4 6.5,12.7 6.6,13L4.5,14.6L6.5,17.4L9,16.5C9.6,17 10.3,17.4 11,17.7L11.3,20.2H14.7L15,17.7C15.7,17.4 16.4,17 17,16.5L19.5,17.4L21.5,14.6L19.4,13Z"/></svg>
                            Settings
                        </button>
                    </div>
                    <div>Reso · one guest record, one folio, everywhere</div>
                </div>
            </div>
        </t>
    </t>
</templates>
