<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- One-click demo data seed (idempotent; safe to click twice). -->
    <record id="action_seed_control_demo" model="ir.actions.server">
        <field name="name">Generate Demo Data</field>
        <field name="model_id" ref="model_rcloud_tenant"/>
        <field name="state">code</field>
        <field name="code">action = env['rcloud.tenant']._load_demo_data()</field>
    </record>
    <menuitem id="menu_rcloud_control_demo_seed" name="Generate Demo Data"
        parent="menu_rcloud_control_root" action="action_seed_control_demo"
        sequence="60"/>
</odoo>
