<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_hotel_user" model="res.groups">
        <field name="name">Hotel Staff</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Front desk, housekeeping and resort operations staff.</field>
    </record>
    <record id="group_hotel_manager" model="res.groups">
        <field name="name">Hotel Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_hotel_user'))]"/>
        <field name="comment">Full PMS management, configuration override and night audit.</field>
    </record>

    <!-- Multi-property record rules: a user only sees records whose
         property belongs to one of their companies. -->
    <record id="rule_rcloud_property_multi_company" model="ir.rule">
        <field name="name">rcloud.property: multi-company</field>
        <field name="model_id" ref="model_rcloud_property"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
