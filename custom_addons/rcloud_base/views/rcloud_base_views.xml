<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rcloud_property_view_list" model="ir.ui.view">
        <field name="name">rcloud.property.list</field>
        <field name="model">rcloud.property</field>
        <field name="arch" type="xml">
            <list string="Properties">
                <field name="name"/>
                <field name="code"/>
                <field name="city"/>
                <field name="company_id" optional="hide"/>
                <field name="currency_id" optional="hide"/>
                <field name="total_rooms" string="Rooms"/>
            </list>
        </field>
    </record>

    <record id="rcloud_property_view_kanban" model="ir.ui.view">
        <field name="name">rcloud.property.kanban</field>
        <field name="model">rcloud.property</field>
        <field name="arch" type="xml">
            <kanban records_draggable="false">
                <field name="name"/><field name="code"/><field name="city"/>
                <field name="country_id"/><field name="total_rooms"/>
                <field name="phone"/><field name="email"/>
                <templates><t t-name="card">
                    <div class="p-2">
                        <div class="d-flex justify-content-between">
                            <strong class="o_kanban_record_title"><field name="name"/></strong>
                            <span class="badge text-bg-light"><field name="code"/></span>
                        </div>
                        <div class="text-muted small">
                            <t t-if="record.city.raw_value"><field name="city"/><t t-if="record.country_id.raw_value">, </t></t>
                            <field name="country_id"/>
                        </div>
                        <div class="small mt-1">
                            <i class="fa fa-bed me-1" aria-hidden="true"/>
                            <field name="total_rooms"/> rooms
                        </div>
                        <div class="small text-muted mt-1" t-if="record.phone.raw_value">
                            <i class="fa fa-phone me-1" aria-hidden="true"/>
                            <field name="phone"/>
                        </div>
                    </div>
                </t></templates>
            </kanban>
        </field>
    </record>

    <record id="rcloud_property_view_form" model="ir.ui.view">
        <field name="name">rcloud.property.form</field>
        <field name="model">rcloud.property</field>
        <field name="arch" type="xml">
            <form string="Property">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_rooms" type="object"
                            class="oe_stat_button" icon="fa-bed">
                            <field name="total_rooms" widget="statinfo"
                                string="Rooms"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Property name"/></h1>
                    </div>
                    <group>
                        <group string="General">
                            <field name="code"/>
                            <field name="company_id"/>
                            <field name="currency_id"/>
                            <field name="timezone"/>
                        </group>
                        <group string="Address">
                            <field name="street"/>
                            <field name="street2"/>
                            <field name="city"/>
                            <field name="country_id"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                        <group string="Operations">
                            <field name="checkin_time" widget="float_time"/>
                            <field name="checkout_time" widget="float_time"/>
                            <field name="tax_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="rcloud_property_view_search" model="ir.ui.view">
        <field name="name">rcloud.property.search</field>
        <field name="model">rcloud.property</field>
        <field name="arch" type="xml">
            <search string="Properties">
                <field name="name"/>
                <field name="code"/>
                <field name="city"/>
            </search>
        </field>
    </record>

    <record id="action_rcloud_property" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">rcloud.property</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <menuitem id="menu_rcloud_root" name="Reso PMS"
        web_icon="rcloud_base,static/description/icon.png"
        groups="rcloud_base.group_hotel_user"
        sequence="1"/>
    <menuitem id="menu_rcloud_property" name="Properties"
        parent="menu_rcloud_root" action="action_rcloud_property"
        sequence="90"/>
</odoo>
