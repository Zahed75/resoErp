<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Multi-company isolation on every property-scoped model. -->
    <record id="rule_room_type_multi_company" model="ir.rule">
        <field name="name">rcloud.room.type: multi-company</field>
        <field name="model_id" ref="model_rcloud_room_type"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_room_multi_company" model="ir.rule">
        <field name="name">rcloud.room: multi-company</field>
        <field name="model_id" ref="model_rcloud_room"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_rate_plan_multi_company" model="ir.rule">
        <field name="name">rcloud.rate.plan: multi-company</field>
        <field name="model_id" ref="model_rcloud_rate_plan"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_reservation_multi_company" model="ir.rule">
        <field name="name">rcloud.reservation: multi-company</field>
        <field name="model_id" ref="model_rcloud_reservation"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_folio_multi_company" model="ir.rule">
        <field name="name">rcloud.folio: multi-company</field>
        <field name="model_id" ref="model_rcloud_folio"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
