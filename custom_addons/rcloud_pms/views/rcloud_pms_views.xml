<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================= Room Types ================= -->
    <record id="room_type_view_list" model="ir.ui.view">
        <field name="name">rcloud.room.type.list</field>
        <field name="model">rcloud.room.type</field>
        <field name="arch" type="xml">
            <list string="Room Types">
                <field name="name"/>
                <field name="property_id"/>
                <field name="code"/>
                <field name="base_occupancy"/>
                <field name="max_occupancy"/>
                <field name="default_rate"/>
                <field name="room_count"/>
            </list>
        </field>
    </record>
    <record id="room_type_view_form" model="ir.ui.view">
        <field name="name">rcloud.room.type.form</field>
        <field name="model">rcloud.room.type</field>
        <field name="arch" type="xml">
            <form string="Room Type">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="property_id"/>
                            <field name="code"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="base_occupancy"/>
                            <field name="max_occupancy"/>
                            <field name="default_rate"/>
                        </group>
                    </group>
                    <group string="Amenities">
                        <field name="amenity_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_room_type" model="ir.actions.act_window">
        <field name="name">Room Types</field>
        <field name="res_model">rcloud.room.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ================= Rooms ================= -->
    <record id="room_view_list" model="ir.ui.view">
        <field name="name">rcloud.room.list</field>
        <field name="model">rcloud.room</field>
        <field name="arch" type="xml">
            <list string="Rooms"
                  decoration-success="status == 'vacant_clean'"
                  decoration-warning="status == 'vacant_dirty'"
                  decoration-danger="is_ooo">
                <field name="name"/>
                <field name="property_id"/>
                <field name="room_type_id"/>
                <field name="floor"/>
                <field name="status"/>
                <field name="housekeeping_state"/>
                <field name="is_ooo" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="room_view_kanban" model="ir.ui.view">
        <field name="name">rcloud.room.kanban</field>
        <field name="model">rcloud.room</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" records_draggable="false">
                <field name="name"/>
                <field name="room_type_id"/>
                <field name="status"/>
                <field name="housekeeping_state"/>
                <progressbar field="housekeeping_state"
                    colors='{"clean": "success", "dirty": "danger", "inspected": "info"}'/>
                <templates>
                    <t t-name="card">
                        <div class="p-2">
                            <strong class="o_kanban_record_title"><field name="name"/></strong>
                            <div class="text-muted small"><field name="room_type_id"/></div>
                            <div class="mt-1">
                                <button name="action_set_clean" type="object"
                                    class="btn btn-primary btn-sm">Clean</button>
                                <button name="action_set_dirty" type="object"
                                    class="btn btn-secondary btn-sm ms-1">Dirty</button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="room_view_form" model="ir.ui.view">
        <field name="name">rcloud.room.form</field>
        <field name="model">rcloud.room</field>
        <field name="arch" type="xml">
            <form string="Room">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="property_id"/>
                            <field name="room_type_id"/>
                            <field name="floor"/>
                        </group>
                        <group>
                            <field name="status"/>
                            <field name="housekeeping_state"/>
                            <field name="is_ooo"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="room_view_search" model="ir.ui.view">
        <field name="name">rcloud.room.search</field>
        <field name="model">rcloud.room</field>
        <field name="arch" type="xml">
            <search string="Rooms">
                <field name="name"/>
                <field name="property_id"/>
                <field name="room_type_id"/>
                <filter string="Out of Order" name="ooo" domain="[('is_ooo', '=', True)]"/>
                <filter string="Dirty" name="dirty" domain="[('housekeeping_state', '=', 'dirty')]"/>
            </search>
        </field>
    </record>
    <record id="action_room" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">rcloud.room</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <!-- ================= Rate Plans ================= -->
    <record id="rate_plan_view_list" model="ir.ui.view">
        <field name="name">rcloud.rate.plan.list</field>
        <field name="model">rcloud.rate.plan</field>
        <field name="arch" type="xml">
            <list string="Rate Plans">
                <field name="name"/>
                <field name="property_id"/>
                <field name="room_type_id"/>
                <field name="channel"/>
                <field name="cancellation_policy"/>
            </list>
        </field>
    </record>
    <record id="rate_plan_view_form" model="ir.ui.view">
        <field name="name">rcloud.rate.plan.form</field>
        <field name="model">rcloud.rate.plan</field>
        <field name="arch" type="xml">
            <form string="Rate Plan">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="property_id"/>
                            <field name="room_type_id"/>
                        </group>
                        <group>
                            <field name="channel"/>
                            <field name="cancellation_policy"/>
                        </group>
                    </group>
                    <group string="Rate Calendar">
                        <field name="calendar_line_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="date"/>
                                <field name="rate"/>
                                <field name="min_stay"/>
                                <field name="closed_to_arrival"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_rate_plan" model="ir.actions.act_window">
        <field name="name">Rate Plans</field>
        <field name="res_model">rcloud.rate.plan</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ================= Availability ================= -->
    <record id="availability_view_list" model="ir.ui.view">
        <field name="name">rcloud.availability.list</field>
        <field name="model">rcloud.availability</field>
        <field name="arch" type="xml">
            <list string="Availability">
                <field name="date"/>
                <field name="property_id"/>
                <field name="room_type_id"/>
                <field name="total"/>
                <field name="sold"/>
                <field name="blocked"/>
            </list>
        </field>
    </record>
    <record id="availability_view_search" model="ir.ui.view">
        <field name="name">rcloud.availability.search</field>
        <field name="model">rcloud.availability</field>
        <field name="arch" type="xml">
            <search string="Availability">
                <field name="room_type_id"/>
                <field name="date"/>
            </search>
        </field>
    </record>
    <record id="action_availability" model="ir.actions.act_window">
        <field name="name">Availability</field>
        <field name="res_model">rcloud.availability</field>
        <field name="view_mode">list</field>
    </record>

    <!-- ================= Reservations ================= -->
    <record id="reservation_view_list" model="ir.ui.view">
        <field name="name">rcloud.reservation.list</field>
        <field name="model">rcloud.reservation</field>
        <field name="arch" type="xml">
            <list string="Reservations"
                  decoration-success="state == 'checked_in'"
                  decoration-warning="state in ('hold', 'confirmed')"
                  decoration-muted="state in ('cancelled', 'no_show')">
                <field name="name"/>
                <field name="guest_id"/>
                <field name="property_id"/>
                <field name="room_id"/>
                <field name="arrival"/>
                <field name="departure"/>
                <field name="state" widget="badge"/>
                <field name="amount_total"/>
            </list>
        </field>
    </record>
    <record id="reservation_view_calendar" model="ir.ui.view">
        <field name="name">rcloud.reservation.calendar</field>
        <field name="model">rcloud.reservation</field>
        <field name="arch" type="xml">
            <calendar string="Reservations" date_start="arrival" date_stop="departure"
                      color="room_type_id">
                <field name="guest_id"/>
                <field name="name"/>
            </calendar>
        </field>
    </record>
    <record id="reservation_view_form" model="ir.ui.view">
        <field name="name">rcloud.reservation.form</field>
        <field name="model">rcloud.reservation</field>
        <field name="arch" type="xml">
            <form string="Reservation">
                <header>
                    <button name="action_hold" string="Hold" type="object"
                        invisible="state != 'draft'"/>
                    <button name="action_confirm" string="Confirm" type="object"
                        invisible="state not in ('draft', 'hold')" class="btn-primary"/>
                    <button name="action_check_in" string="Check In" type="object"
                        invisible="state != 'confirmed'" class="btn-primary"/>
                    <button name="action_check_out" string="Check Out" type="object"
                        invisible="state != 'checked_in'" class="btn-primary"/>
                    <button name="action_cancel" string="Cancel" type="object"
                        invisible="state not in ('hold', 'confirmed')"/>
                    <button name="action_no_show" string="No Show" type="object"
                        invisible="state != 'confirmed'"
                        groups="rcloud_base.group_hotel_manager"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,hold,confirmed,checked_in,checked_out,invoiced"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="property_id"/>
                            <field name="guest_id"/>
                            <field name="source"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="arrival"/>
                            <field name="departure"/>
                            <field name="adults"/>
                            <field name="children"/>
                        </group>
                        <group>
                            <field name="room_type_id"/>
                            <field name="rate_plan_id"/>
                            <field name="room_id"/>
                            <field name="folio_id"/>
                            <field name="amount_total"/>
                        </group>
                    </group>
                    <group string="Nightly Lines">
                        <field name="line_ids" nolabel="1">
                            <list>
                                <field name="date"/>
                                <field name="room_type_id"/>
                                <field name="rate_plan_id"/>
                                <field name="rate"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="reservation_view_search" model="ir.ui.view">
        <field name="name">rcloud.reservation.search</field>
        <field name="model">rcloud.reservation</field>
        <field name="arch" type="xml">
            <search string="Reservations">
                <field name="name"/>
                <field name="guest_id"/>
                <field name="property_id"/>
                <filter string="Arrivals Today" name="arrivals_today"
                    domain="[('arrival', '=', context_today()), ('state', 'in', ('hold', 'confirmed'))]"/>
                <filter string="Departures Today" name="departures_today"
                    domain="[('departure', '=', context_today()), ('state', '=', 'checked_in')]"/>
                <filter string="In-House" name="in_house"
                    domain="[('state', '=', 'checked_in')]"/>
                <group>
                    <filter string="Property" name="group_property" context="{'group_by': 'property_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Source" name="group_source" context="{'group_by': 'source'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_reservation" model="ir.actions.act_window">
        <field name="name">Reservations</field>
        <field name="res_model">rcloud.reservation</field>
        <field name="view_mode">list,form,calendar</field>
    </record>
    <record id="action_arrivals" model="ir.actions.act_window">
        <field name="name">Arrivals Today</field>
        <field name="res_model">rcloud.reservation</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_arrivals_today': 1}</field>
    </record>
    <record id="action_inhouse" model="ir.actions.act_window">
        <field name="name">In-House Guests</field>
        <field name="res_model">rcloud.reservation</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_in_house': 1}</field>
    </record>

    <!-- ================= Folios ================= -->
    <record id="folio_view_list" model="ir.ui.view">
        <field name="name">rcloud.folio.list</field>
        <field name="model">rcloud.folio</field>
        <field name="arch" type="xml">
            <list string="Folios"
                  decoration-warning="state == 'open'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="property_id"/>
                <field name="balance"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="folio_view_form" model="ir.ui.view">
        <field name="name">rcloud.folio.form</field>
        <field name="model">rcloud.folio</field>
        <field name="arch" type="xml">
            <form string="Folio">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="reservation_id"/>
                            <field name="partner_id"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="balance"/>
                        </group>
                    </group>
                    <group string="Charges">
                        <field name="line_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="date"/>
                                <field name="description"/>
                                <field name="qty"/>
                                <field name="unit_price"/>
                                <field name="amount"/>
                                <field name="source"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_folio" model="ir.actions.act_window">
        <field name="name">Folios</field>
        <field name="res_model">rcloud.folio</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
