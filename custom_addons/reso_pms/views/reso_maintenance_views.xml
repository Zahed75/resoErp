<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Maintenance Ticket Form View -->
    <record id="view_reso_maintenance_ticket_form" model="ir.ui.view">
        <field name="name">reso.maintenance.ticket.form</field>
        <field name="model">reso.maintenance.ticket</field>
        <field name="arch" type="xml">
            <form string="Maintenance Ticket">
                <header>
                    <button name="action_start" string="Start Work" type="object" class="oe_highlight" invisible="state != 'new'"/>
                    <button name="action_resolve" string="Mark Resolved" type="object" class="oe_highlight" invisible="state not in ('new', 'in_progress')"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('resolved', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,in_progress,resolved,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <h2>
                            <field name="title" placeholder="Problem summary / title..."/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="property_id"/>
                            <field name="room_id"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group>
                            <field name="assigned_user_id"/>
                            <field name="request_date"/>
                            <field name="resolution_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description &amp; Resolution">
                            <field name="description" placeholder="Provide problem details or resolution notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Maintenance Ticket Tree View -->
    <record id="view_reso_maintenance_ticket_tree" model="ir.ui.view">
        <field name="name">reso.maintenance.ticket.tree</field>
        <field name="model">reso.maintenance.ticket</field>
        <field name="arch" type="xml">
            <list string="Maintenance Tickets">
                <field name="name"/>
                <field name="title"/>
                <field name="property_id"/>
                <field name="room_id"/>
                <field name="priority" widget="priority"/>
                <field name="assigned_user_id"/>
                <field name="request_date"/>
                <field name="state" widget="badge" decoration-info="state == 'new'" decoration-warning="state == 'in_progress'" decoration-success="state == 'resolved'"/>
            </list>
        </field>
    </record>

    <!-- Maintenance Ticket Action -->
    <record id="action_reso_maintenance_ticket" model="ir.actions.act_window">
        <field name="name">Maintenance Tickets</field>
        <field name="res_model">reso.maintenance.ticket</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>