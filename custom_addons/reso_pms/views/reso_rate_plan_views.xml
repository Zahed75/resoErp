<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="reso_rate_plan_view_list" model="ir.ui.view">
        <field name="name">reso.rate.plan.list</field>
        <field name="model">reso.rate.plan</field>
        <field name="arch" type="xml">
            <list string="Rate Plans">
                <field name="name"/>
                <field name="property_id"/>
                <field name="room_type_id"/>
                <field name="base_price" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="min_stay"/>
                <field name="meal_plan"/>
                <field name="cancellation_policy"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="reso_rate_plan_view_form" model="ir.ui.view">
        <field name="name">reso.rate.plan.form</field>
        <field name="model">reso.rate.plan</field>
        <field name="arch" type="xml">
            <form string="Rate Plan">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Rate Plan"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="property_id"/>
                            <field name="room_type_id"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="currency_id"/>
                            <field name="base_price" widget="monetary"/>
                            <field name="min_stay"/>
                        </group>
                    </group>
                    <group string="Conditions">
                        <group>
                            <field name="meal_plan"/>
                            <field name="cancellation_policy"/>
                        </group>
                        <group>
                            <field name="deposit_required"/>
                            <field name="deposit_percent"
                                   invisible="not deposit_required"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Seasonal Prices" name="seasons">
                            <field name="season_line_ids">
                                <list editable="bottom">
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="price" widget="monetary"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="reso_rate_plan_view_search" model="ir.ui.view">
        <field name="name">reso.rate.plan.search</field>
        <field name="model">reso.rate.plan</field>
        <field name="arch" type="xml">
            <search string="Rate Plans">
                <field name="name"/>
                <field name="property_id"/>
                <field name="room_type_id"/>
                <filter string="Deposit Required" name="deposit"
                        domain="[('deposit_required', '=', True)]"/>
                <filter string="Non-Refundable" name="non_refundable"
                        domain="[('cancellation_policy', '=', 'non_refundable')]"/>
                <group>
                    <filter string="Property" name="group_property" context="{'group_by': 'property_id'}"/>
                    <filter string="Room Type" name="group_room_type" context="{'group_by': 'room_type_id'}"/>
                    <filter string="Meal Plan" name="group_meal" context="{'group_by': 'meal_plan'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_reso_rate_plan" model="ir.actions.act_window">
        <field name="name">Rate Plans</field>
        <field name="res_model">reso.rate.plan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
