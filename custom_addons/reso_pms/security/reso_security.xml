<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_reso" model="ir.module.category">
        <field name="name">Reso Resort</field>
        <field name="description">Reso Resort Management System</field>
        <field name="sequence">50</field>
    </record>

    <record id="res_groups_privilege_pms" model="res.groups.privilege">
        <field name="name">PMS</field>
        <field name="category_id" ref="module_category_reso"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_pms_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_pms"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_pms_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_pms"/>
        <field name="implied_ids" eval="[(4, ref('group_pms_user'))]"/>
    </record>

    <!-- Implicit access for standard internal users and administrators -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_pms_user'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_pms_manager'))]"/>
    </record>

    <!-- Multi-company record rules -->
    <record id="reso_property_company_rule" model="ir.rule">
        <field name="name">Reso Property: multi-company</field>
        <field name="model_id" ref="model_reso_property"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="reso_room_type_company_rule" model="ir.rule">
        <field name="name">Reso Room Type: multi-company</field>
        <field name="model_id" ref="model_reso_room_type"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="reso_room_company_rule" model="ir.rule">
        <field name="name">Reso Room: multi-company</field>
        <field name="model_id" ref="model_reso_room"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="reso_rate_plan_company_rule" model="ir.rule">
        <field name="name">Reso Rate Plan: multi-company</field>
        <field name="model_id" ref="model_reso_rate_plan"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="reso_rate_plan_season_company_rule" model="ir.rule">
        <field name="name">Reso Rate Plan Season: multi-company</field>
        <field name="model_id" ref="model_reso_rate_plan_season"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="reso_booking_company_rule" model="ir.rule">
        <field name="name">Reso Booking: multi-company</field>
        <field name="model_id" ref="model_reso_booking"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
