<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================= KYC Records ================= -->
    <record id="kyc_record_view_list" model="ir.ui.view">
        <field name="name">rcloud.kyc.record.list</field>
        <field name="model">rcloud.kyc.record</field>
        <field name="arch" type="xml">
            <list string="KYC Records"
                  decoration-success="state == 'verified'"
                  decoration-danger="state == 'rejected'">
                <field name="partner_id"/>
                <field name="property_id"/>
                <field name="doc_type"/>
                <field name="doc_number_display"/>
                <field name="issuing_country" optional="hide"/>
                <field name="expiry_date" optional="show"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="kyc_record_view_kanban" model="ir.ui.view">
        <field name="name">rcloud.kyc.record.kanban</field>
        <field name="model">rcloud.kyc.record</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" records_draggable="false">
                <field name="partner_id"/><field name="property_id"/>
                <field name="doc_type"/><field name="doc_number_display"/>
                <field name="issuing_country"/><field name="expiry_date"/>
                <field name="state"/>
                <templates><t t-name="card">
                    <div class="p-2">
                        <div class="d-flex justify-content-between">
                            <strong class="o_kanban_record_title"><field name="doc_type"/></strong>
                            <span class="badge"
                                t-att-class="record.state.raw_value == 'verified' ? 'text-bg-success' : record.state.raw_value == 'submitted' ? 'text-bg-info' : record.state.raw_value == 'rejected' ? 'text-bg-danger' : 'text-bg-warning'"><field name="state"/></span>
                        </div>
                        <strong><field name="partner_id"/></strong>
                        <div class="small text-muted">
                            <span class="font-monospace"><field name="doc_number_display"/></span>
                        </div>
                        <div class="small mt-1">
                            <t t-if="record.issuing_country.raw_value"><field name="issuing_country"/> · </t>
                            <t t-if="record.expiry_date.raw_value">Expires <field name="expiry_date"/></t>
                        </div>
                        <div class="small text-muted mt-1"><field name="property_id"/></div>
                    </div>
                </t></templates>
            </kanban>
        </field>
    </record>
    <record id="kyc_record_view_form" model="ir.ui.view">
        <field name="name">rcloud.kyc.record.form</field>
        <field name="model">rcloud.kyc.record</field>
        <field name="arch" type="xml">
            <form string="KYC Record">
                <header>
                    <button name="action_submit" string="Submit" type="object"
                        invisible="state != 'pending'" class="btn-primary"/>
                    <button name="action_verify" string="Verify" type="object"
                        invisible="state != 'submitted'" class="btn-primary"
                        groups="rcloud_kyc.group_kyc_officer"/>
                    <button name="action_reject" string="Reject" type="object"
                        invisible="state != 'submitted'"
                        groups="rcloud_kyc.group_kyc_officer"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="pending,submitted,verified,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="doc_type"/></h1></div>
                    <group>
                        <group string="Guest">
                            <field name="partner_id"/>
                            <field name="property_id"/>
                        </group>
                        <group string="Document">
                            <!-- Raw number: KYC officers and hotel managers
                                 only; everyone else sees the masked value. -->
                            <field name="doc_number"
                                groups="rcloud_kyc.group_kyc_officer,rcloud_base.group_hotel_manager"/>
                            <field name="doc_number_display"
                                groups="!rcloud_kyc.group_kyc_officer"/>
                            <field name="issuing_country"/>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                        </group>
                    </group>
                    <group string="Verification">
                        <field name="verified_by"/>
                        <field name="verified_on"/>
                        <field name="rejection_reason"/>
                    </group>
                    <group string="Attachments">
                        <field name="attachment_ids" widget="many2many_binary"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_kyc_record" model="ir.actions.act_window">
        <field name="name">KYC Records</field>
        <field name="res_model">rcloud.kyc.record</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <!-- ================= Property: KYC flag ================= -->
    <record id="rcloud_property_view_form_inherit_kyc" model="ir.ui.view">
        <field name="name">rcloud.property.form.inherit.kyc</field>
        <field name="model">rcloud.property</field>
        <field name="inherit_id" ref="rcloud_base.rcloud_property_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[field[@name='code']]" position="inside">
                <field name="kyc_required"/>
            </xpath>
        </field>
    </record>

    <!-- ================= Partner: GDPR actions + KYC ================= -->
    <record id="res_partner_view_form_inherit_kyc" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.kyc</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_gdpr_export" string="GDPR Export"
                        type="object" groups="rcloud_kyc.group_kyc_officer"/>
                    <button name="action_gdpr_erase" string="GDPR Erase"
                        type="object" groups="rcloud_base.group_hotel_manager"/>
                </header>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="KYC" groups="rcloud_kyc.group_kyc_officer">
                    <field name="kyc_record_ids">
                        <list>
                            <field name="doc_type"/>
                            <field name="doc_number_display"/>
                            <field name="state"/>
                            <field name="expiry_date"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ================= Menu ================= -->
    <menuitem id="menu_rcloud_kyc" name="KYC Records"
        parent="rcloud_base.menu_rcloud_root" action="action_kyc_record"
        groups="rcloud_kyc.group_kyc_officer" sequence="40"/>

    <!-- Backfill: mirror existing KYC attachments into the Documents app -->
    <record id="action_kyc_sync_documents" model="ir.actions.server">
        <field name="name">Sync Documents Folder</field>
        <field name="model_id" ref="model_rcloud_kyc_record"/>
        <field name="state">code</field>
        <field name="code">model.action_sync_documents()</field>
    </record>
    <menuitem id="menu_kyc_sync_documents" name="Sync to Documents App"
        parent="menu_rcloud_kyc" action="action_kyc_sync_documents"
        groups="rcloud_kyc.group_kyc_officer" sequence="10"/>
</odoo>
