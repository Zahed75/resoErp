# Copy this file to .env and adjust values before running docker compose up -d

# Database
DB_USER=odoo
DB_PASSWORD=change_me_strong_password
DB_NAME=resoSolution

# Odoo master/admin password (database manager) — set a strong one for any
# publicly reachable server.
ODOO_ADMIN_PASSWD=change_me_strong_admin_password

# Load demo data (demo properties, rooms, bookings, owners) on first install.
# Set to false for a clean production database.
DEMO=true

# Modules installed/updated on container start (first boot installs, later
# boots use UPDATE_MODULES to upgrade code without reinstalling data).
# The rcloud suite is the current product stack (white theme, sidebar,
# PMS dashboard); the legacy reso_pms/reso_ownership modules must NOT be
# installed — they duplicate the "Reso PMS" app and show the old screens.
INIT_MODULES=rcloud_base,rcloud_pms,rcloud_pms_account,rcloud_ownership,rcloud_portal_api,rcloud_pos_bridge,rcloud_ui,rcloud_whatsapp,rcloud_tenant_agent,rcloud_control,rcloud_kyc
UPDATE_MODULES=

# Ports (host side)
HTTP_PORT=8069        # Odoo backend (keep private or restrict in firewall)
LONGPOLLING_PORT=8072 # Odoo longpolling/websocket
WEBSITE_PORT=8080     # Public Angular booking website (point Nginx here)
